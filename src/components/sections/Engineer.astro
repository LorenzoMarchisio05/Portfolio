---
import Silhouette from "../components/Silhouette.astro";
import { useI18n } from "../../i18n";

const { t } = useI18n(Astro.url);
---

<section id="engineer" class="section">
  <!-- Phone layout only: the brace pair drops behind the copy instead of
       sitting in its own column. -->
  <div class="backdrop" aria-hidden="true">
    <div class="backdrop-box" data-par="-.1">
      <div class="tilt">
        <Silhouette kind="braces" scale={300} color="rgba(238,235,228,.3)" />
      </div>
    </div>
  </div>

  <div data-par=".04" data-par-m="0">
  <header class="head" data-rise>
    <div class="title">
      <p class="eyebrow">000° · {t.roles.engineer}</p>
      <h2 class="headline" set:html={t.engineer.headline} />
    </div>
    <p class="lead intro">{t.engineer.intro}</p>
  </header>
  </div>

  <div class="body">
    <div class="list">
    <ol class="method" data-rise>
      {
        t.engineer.method.map((m, i) => (
          <li>
            <span class="index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="principle">
              <h3>{m.title}</h3>
              <p class="lead">{m.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a class="cv" href="/cv.pdf" data-rise>{t.engineer.cv}</a>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    gap: 24px clamp(32px, 4vw, 64px);
    flex-wrap: wrap;
  }

  .head p {
    margin: 0;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }


  /* Sits right beside the headline, level with its last line. */
  .intro {
    max-width: 36ch;
    font-size: 17px;
    line-height: 1.55;
    margin-bottom: 0.45em;
  }

  /* In the headline, which is set from the dictionary as HTML. */
  .title :global(.narrow-only) {
    display: none;
  }

  .body {
    display: flex;
    align-items: flex-start;
    gap: clamp(32px, 5vw, 80px);
    flex-wrap: wrap;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 36px;
    flex: 1 1 520px;
    max-width: 880px;
    min-width: 0;
  }

  .method {
    min-width: 0;
    margin: 0;
    list-style: none;
  }

  .method li {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    align-items: baseline;
    padding: 26px 0 24px;
    border-top: 1px solid var(--hair-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .method li {
      position: relative;
      transition: padding-left 320ms var(--ease);
    }

    .method li::before {
      content: "";
      position: absolute;
      left: 0;
      top: -1px;
      width: 100%;
      height: 1px;
      background: var(--signal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 520ms var(--ease);
    }

    .method li:hover {
      padding-left: 12px;
    }

    .method li:hover::before {
      transform: scaleX(1);
    }

    /* Reading order: the row near the middle of the screen is lit, the rest
       recede. A copper rail beside the list fills as you pass through it. */
    @supports (animation-timeline: view()) {
      .method li {
        animation: method-focus linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .method li .index {
        display: inline-block;
        transform-origin: left center;
        animation: index-focus linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .method li h3 {
        animation: title-focus linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .method::after {
        animation: rail-fill linear both;
        animation-timeline: view();
        animation-range: cover 18% cover 82%;
      }
    }
  }

  @keyframes method-focus {
    0% { opacity: 0.16; translate: 28px 0; }
    38%, 62% { opacity: 1; translate: 0 0; }
    100% { opacity: 0.16; translate: 0 0; }
  }

  @keyframes index-focus {
    0%, 100% { scale: 1; }
    38%, 62% { scale: 1.5; }
  }

  @keyframes title-focus {
    38%, 62% { color: var(--bone); }
    0%, 100% { color: var(--warm); }
  }

  @keyframes rail-fill {
    from { transform: scaleY(0); }
  }

  .method {
    position: relative;
    padding-left: clamp(18px, 2.4vw, 32px);
  }

  .method::before,
  .method::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hair-3);
  }

  .method::after {
    width: 2px;
    background: var(--signal);
    transform-origin: top;
    box-shadow: 0 0 14px color-mix(in srgb, var(--signal) 60%, transparent);
  }

  .index {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--signal);
    padding-top: 6px;
    min-width: 2ch;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  .principle h3 {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 31px);
    font-weight: 600;
    font-stretch: 86%;
    letter-spacing: -0.02em;
    line-height: 1.06;
  }

  .principle p {
    font-size: 16px;
    max-width: 460px;
  }




  .cv {
    margin-left: clamp(18px, 2.4vw, 32px);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 6px;
    width: fit-content;
  }

  /* The brace pair is a faint backdrop on the right, behind the list. */
  .backdrop {
    display: flex;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .backdrop-box {
    position: sticky;
    top: clamp(96px, 16vh, 180px);
    width: min(620px, 44vw);
    aspect-ratio: 1;
    flex: 0 0 auto;
    margin-right: 2vw;
    opacity: 0.6;
  }

  .backdrop .tilt {
    position: absolute;
    inset: 6%;
    transform: perspective(1100px) rotateY(-11deg) rotateX(5deg);
  }

  @media (max-width: 768px) {
    #engineer {
      overflow: clip;
      gap: 36px;
    }

    .backdrop {
      display: flex;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      justify-content: flex-end;
      align-items: flex-start;
    }

    .backdrop-box {
      position: sticky;
      top: 96px;
      width: min(520px, 112vw);
      aspect-ratio: 1;
      flex: 0 0 auto;
      align-self: flex-start;
      opacity: 0.55;
    }

    .backdrop .tilt {
      position: absolute;
      inset: 6%;
      transform: perspective(900px) rotateY(-10deg) rotateX(4deg);
    }

    .head {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }

    .title :global(.narrow-only) {
      display: inline;
    }

    .body {
      flex-direction: column;
      gap: 30px;
    }

    .method {
      flex: 1 1 auto;
      min-width: 0;
      width: 100%;
    }

    .method li {
      flex-direction: column;
      gap: 8px;
      padding: 22px 0 20px;
    }

    .index {
      font-size: 10px;
      padding-top: 0;
    }

    .principle h3 {
      font-size: 23px;
      line-height: 1.08;
    }

    .principle p {
      font-size: 15px;
      max-width: none;
    }

    .cv {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
