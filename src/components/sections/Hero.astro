---
// 000°–360°: the readout in the eyebrow is the same scalar the top bar shows.
import { useI18n } from "../../i18n";

const { t } = useI18n(Astro.url);
const ticks = ["000", "120", "240", "360"];
const lines = ["LORENZO", "MARCHISIO"];
---

<section id="top" data-lit>
  <div class="copy" data-par="-.04" data-par-m="0">
    <p class="eyebrow"><span data-angle>068°</span> · {t.hero.status}</p>
    <h1 class="name" aria-label="LORENZO MARCHISIO">
      {lines.map((w) => (
        <span class="ln" aria-hidden="true">
          {[...w].map((c, i) => <span class="l" style={`--i:${i}`}>{c}</span>)}
        </span>
      ))}
    </h1>
    <p class="intro">{t.hero.intro}</p>
    <p class="meta">
      {t.hero.study}<br />
      {t.hero.city}<span class="wide">{t.hero.region}</span> · 50.88°N 4.70°E
    </p>
  </div>

  <div class="scale-row">
    <div class="scale">
      <div class="ticks">{ticks.map((t) => <span>{t}</span>)}</div>
      <div class="rule">
        <i style="left:0"></i>
        <i style="left:33.33%"></i>
        <i style="left:66.66%"></i>
        <i style="left:100%"></i>
        <div id="angHead"></div>
      </div>
    </div>
    <p class="hint">{t.hero.hint}<span class="narrow"> ↓</span></p>
  </div>
</section>

<style>
  #top {
    position: relative;
    /* The design measures 100vh *plus* the padding — the orbit scale is meant
       to sit right on the fold, not above it. */
    box-sizing: content-box;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px var(--pad-x) 56px;
  }

  .copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
    max-width: 760px;
  }

  .copy p {
    margin: 0;
  }

  .name {
    margin: 0;
    font-size: clamp(56px, 11vw, 168px);
    font-weight: 700;
    font-stretch: 78%;
    letter-spacing: -0.035em;
    line-height: 0.82;
  }

  .eyebrow {
    letter-spacing: 0.2em;
  }

  .ln {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0;
    padding: 0.1em 0.04em;
    margin: -0.1em -0.04em;
  }

  /* Load sequence: the name rises out of its line, the ruler draws, then the
     copy settles. Plays once; content is in place without it. */
  @keyframes hero-line {
    from { transform: translateY(104%); }
  }
  @keyframes hero-fade {
    from { opacity: 0; translate: 0 12px; }
  }
  @keyframes hint-pulse {
    50% { opacity: 0.4; }
  }
  @keyframes aurora {
    from { translate: -4% -3%; scale: 1; }
    to { translate: 5% 4%; scale: 1.18; }
  }
  @keyframes spread-l {
    to { translate: -9vw 0; }
  }
  @keyframes spread-r {
    to { translate: 7vw 0; }
  }
  @keyframes hero-draw {
    from { transform: scaleX(0); }
  }
  @keyframes hero-tick {
    from { opacity: 0; transform: scaleY(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .l {
      display: inline-block;
      animation: hero-line 900ms var(--ease) calc(var(--i) * 45ms + var(--d, 0ms)) both;
      transition: translate 320ms var(--ease), color 160ms linear;
    }
    .ln:nth-child(2) { --d: 200ms; }
    /* Each letter answers the pointer on its own. */
    .l:hover {
      color: var(--signal);
      translate: 0 -0.05em;
    }
    .hint { animation: hero-fade 700ms var(--ease) 1000ms both, hint-pulse 2.6s ease-in-out 2.2s infinite; }

    /* A slow aurora behind the name: two blobs of colour that never settle. */
    #top::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(38% 46% at 28% 42%, color-mix(in srgb, var(--signal) 15%, transparent), transparent 70%),
        radial-gradient(30% 40% at 72% 62%, rgba(232, 163, 61, 0.09), transparent 70%);
      animation: aurora 22s ease-in-out infinite alternate;
    }

    /* On the way out the two lines of the name part, one each side. */
    @supports (animation-timeline: scroll()) {
      .ln {
        animation: spread-l linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
      .ln:nth-child(2) { animation-name: spread-r; }
    }
    .eyebrow { animation: hero-fade 600ms var(--ease) 60ms both; }
    .intro { animation: hero-fade 700ms var(--ease) 520ms both; }
    .meta { animation: hero-fade 700ms var(--ease) 640ms both; }
    .rule { transform-origin: left; animation: hero-draw 1100ms var(--ease) 250ms both; }
    .rule i { transform-origin: top; animation: hero-tick 400ms var(--ease) both; }
    .rule i:nth-of-type(1) { animation-delay: 350ms; }
    .rule i:nth-of-type(2) { animation-delay: 600ms; }
    .rule i:nth-of-type(3) { animation-delay: 850ms; }
    .rule i:nth-of-type(4) { animation-delay: 1100ms; }
    .ticks { animation: hero-fade 600ms var(--ease) 300ms both; }
  }

  .intro {
    font-size: clamp(17px, 2vw, 23px);
    line-height: 1.45;
    max-width: 600px;
    text-wrap: pretty;
  }

  .scale-row {
    position: relative;
    z-index: 1;
    margin-top: 64px;
    display: flex;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }

  .scale {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(320px, 80vw);
  }

  .ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--dim);
  }

  .rule {
    position: relative;
    height: 18px;
    border-top: 1px solid var(--hair-4);
  }

  .rule i {
    position: absolute;
    top: 0;
    width: 1px;
    height: 7px;
    background: rgba(242, 239, 233, 0.4);
  }

  #angHead {
    position: absolute;
    top: -4px;
    left: 0;
    width: 2px;
    height: 15px;
    background: var(--signal);
    will-change: left;
  }

  .hint {
    margin: 0 0 0 auto;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
  }

  .narrow {
    display: none;
  }

  @media (max-width: 768px) {
    #top {
      box-sizing: border-box;
      min-height: 100svh;
      justify-content: flex-end;
      padding: 104px 20px 28px;
    }

    .copy {
      gap: 22px;
    }

    .name {
      font-size: clamp(46px, 14vw, 68px);
      line-height: 0.84;
    }

    .intro {
      font-size: 17px;
    }

    .wide {
      display: none;
    }

    .narrow {
      display: inline;
    }

    .scale-row {
      margin-top: 34px;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .scale {
      width: 100%;
      gap: 9px;
    }

    .rule {
      height: 16px;
    }

    .rule i {
      height: 6px;
    }

    #angHead {
      height: 14px;
    }

    .hint {
      margin: 0;
      font-size: 10px;
    }
  }
</style>
