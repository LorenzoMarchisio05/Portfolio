---
// 000°–360°: the readout in the eyebrow is the same scalar the top bar shows.
const ticks = ["000", "120", "240", "360"];
---

<section id="top">
  <div class="copy" data-par="-.04" data-par-m="0">
    <p class="eyebrow"><span data-angle>068°</span> · UNRESOLVED</p>
    <h1 class="name">LORENZO<br />MARCHISIO</h1>
    <p class="intro">
      Nothing here resolves until you stand somewhere specific. There are three
      such places, and the shape is different from each one.
    </p>
    <p class="meta">
      COMPUTER ENGINEERING · POLITECNICO DI TORINO<br />
      LEUVEN<span class="wide">, VLAAMS-BRABANT</span> — 50.88°N 4.70°E
    </p>
  </div>

  <div class="scale-row">
    <div class="scale">
      <div class="ticks">{ticks.map((t) => <span>{t}</span>)}</div>
      <div class="rule">
        <i style="left:0"></i>
        <i style="left:33.33%"></i>
        <i style="left:66.66%"></i>
        <i style="left:100%"></i>
        <div id="angHead"></div>
      </div>
    </div>
    <p class="hint">SCROLL TO ORBIT<span class="narrow"> ↓</span></p>
  </div>
</section>

<style>
  #top {
    position: relative;
    /* The design measures 100vh *plus* the padding — the orbit scale is meant
       to sit right on the fold, not above it. */
    box-sizing: content-box;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px var(--pad-x) 56px;
  }

  .copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
    max-width: 760px;
  }

  .copy p {
    margin: 0;
  }

  .name {
    margin: 0;
    font-size: clamp(56px, 11vw, 168px);
    font-weight: 700;
    font-stretch: 78%;
    letter-spacing: -0.035em;
    line-height: 0.82;
  }

  .eyebrow {
    letter-spacing: 0.2em;
  }

  .intro {
    font-size: clamp(17px, 2vw, 23px);
    line-height: 1.45;
    max-width: 600px;
    text-wrap: pretty;
  }

  .scale-row {
    position: relative;
    z-index: 1;
    margin-top: 64px;
    display: flex;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }

  .scale {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(320px, 80vw);
  }

  .ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--dim);
  }

  .rule {
    position: relative;
    height: 18px;
    border-top: 1px solid var(--hair-4);
  }

  .rule i {
    position: absolute;
    top: 0;
    width: 1px;
    height: 7px;
    background: rgba(242, 239, 233, 0.4);
  }

  #angHead {
    position: absolute;
    top: -4px;
    left: 0;
    width: 2px;
    height: 15px;
    background: var(--signal);
    will-change: left;
  }

  .hint {
    margin: 0 0 0 auto;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
  }

  .narrow {
    display: none;
  }

  @media (max-width: 768px) {
    #top {
      min-height: 100svh;
      justify-content: flex-end;
      padding: 104px 20px 28px;
    }

    .copy {
      gap: 22px;
    }

    .name {
      font-size: clamp(46px, 14vw, 68px);
      line-height: 0.84;
    }

    .intro {
      font-size: 17px;
    }

    .wide {
      display: none;
    }

    .narrow {
      display: inline;
    }

    .scale-row {
      margin-top: 34px;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .scale {
      width: 100%;
      gap: 9px;
    }

    .rule {
      height: 16px;
    }

    .rule i {
      height: 6px;
    }

    #angHead {
      height: 14px;
    }

    .hint {
      margin: 0;
      font-size: 10px;
    }
  }
</style>
