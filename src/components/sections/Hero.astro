---
import { motion } from "motion/react";
import StaggeredText from "../components/StaggeredText.astro";
---

<section
  id="hero"
  class="min-h-screen w-full grid grid-cols-1 lg:grid-cols-2 content-center relative perspective-midrange px-6 sm:px-12 lg:px-20 overflow-hidden"
>
  <div
    class="hidden lg:block absolute right-0 top-0 w-2/3 h-full -z-10 bg-dotted -rotate-y-[16deg] -translate-z-96 origin-left"
  >
  </div>

  <div class="col flex flex-col justify-center space-y-8 pt-24 pb-10 lg:py-24 lg:px-10">
    <div>
      <h1
        class="text-5xl sm:text-7xl lg:text-8xl 2xl:text-9xl font-bold tracking-tighter text-gray-900"
      >
        <StaggeredText text="Lorenzo Marchisio" duration={0.5} />
      </h1>
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-semibold bg-gradient-to-l from-5% from-gray-900 to-red-700 bg-clip-text text-transparent mt-6 lg:mt-8"
      >
        <StaggeredText text="Full Stack Engineer" duration={0.2} delay={0.1} />
      </h2>
    </div>
    <div class="space-y-8">
      <p class="text-base sm:text-lg lg:text-xl text-gray-700 max-w-2xl leading-relaxed">
        Crafting innovative digital experiences through clean code and creative
        solutions. Specialized in building modern web applications with
        cutting-edge technologies.
      </p>
      <p class="text-base lg:text-lg text-gray-700 max-w-2xl leading-relaxed">
        With a passion for creating seamless user experiences and robust backend
        systems, I bring ideas to life through elegant and efficient code.
      </p>
    </div>
  </div>
  <div class="col pb-20 lg:py-20 flex items-center justify-center flex-col">
    <motion.div
      client:load
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.45, delay: 0.1 }}
      className="block relative w-full sm:w-4/5 h-[240px] sm:h-[320px] lg:h-[350px] lg:rotate-y-[-16deg] lg:translate-z-32 shadow-2xl rounded-xl overflow-hidden bg-gradient-to-br from-gray-900 to-gray-800 border border-gray-700/20 "
    >
      <div class="absolute inset-[2px] bg-white rounded-lg overflow-hidden">
        <div class="h-10 bg-gray-100 border-b flex items-center px-4 space-x-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <div class="grid grid-cols-5 gap-4 p-6 h-full">
          <div class="col-span-3 space-y-4">
            <div class="h-6 bg-gray-200 rounded-md w-3/4"></div>
            <div class="h-4/5 bg-gray-200 rounded-lg"></div>
            <div class="h-10 bg-gray-200 rounded w-full"></div>
          </div>
          <div class="col-span-2 space-y-4">
            <div class="h-48 bg-gray-200 rounded-lg"></div>
            <div class="h-4 bg-gray-200 rounded w-full"></div>
            <div class="h-24 bg-gray-200 rounded-lg"></div>
          </div>
        </div>
      </div>
    </motion.div>
    <div class="flex flex-wrap justify-center gap-4 sm:gap-6 mt-10">
      <a
        href="#contact"
        class="px-6 sm:px-8 py-3 rounded-lg font-medium tracking-wide text-white bg-gradient-to-r from-red-900 to-red-700 shadow-lg hover:from-red-800 hover:to-red-600 transition"
      >
        Contact Me
      </a>
      <a
        href="#skills"
        class="px-6 sm:px-8 py-3 rounded-lg font-medium tracking-wide text-red-800 border border-red-800/25 bg-white/70 shadow-sm hover:bg-white hover:border-red-800/50 transition"
      >
        My Skills
      </a>
    </div>
  </div>
</section>
