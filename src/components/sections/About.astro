---
import { motion } from "motion/react";
import { getCollection } from "astro:content";

const events = await getCollection("journey").then((collection) =>
  collection.map((x) => x.data)
);
---

<section
  id="about"
  class="min-h-screen w-full px-6 sm:px-12 lg:px-20 py-16 lg:py-0"
>
  <div class="max-w-6xl mx-auto">
    <h2
      class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tighter text-gray-900"
    >
      My Journey
    </h2>
    <h3
      class="text-xl sm:text-2xl lg:text-3xl font-semibold bg-gradient-to-l from-5% from-gray-900 to-red-700 bg-clip-text text-transparent mt-6 lg:mt-8 mb-10 lg:mb-16"
    >
      A Timeline of Growth and Achievement
    </h3>

    <div class="relative">
      {/* single rail on mobile, the original pair of rails from lg up */}
      <div
        class="lg:hidden absolute left-3.5 top-0 h-full w-0.5 bg-gradient-to-b from-90% from-gray-200 to-transparent"
      >
      </div>
      <div
        class="hidden lg:block absolute left-[calc(50%-2rem)] top-0 h-full w-0.5 bg-gradient-to-t from-90% from-gray-200 to-transparent"
      >
      </div>
      <div
        class="hidden lg:block absolute left-[calc(50%+1.875rem)] top-0 h-full w-0.5 bg-gradient-to-b from-90% from-gray-200 to-transparent"
      >
      </div>

      {
        events.map((event, index) => (
          <div
            class:list={[
              "relative pl-12 my-10 lg:w-[calc(50%-1rem)] lg:pl-0",
              index % 2 === 0
                ? "lg:ml-auto lg:pl-12"
                : "lg:mr-auto lg:pr-12",
            ]}
          >
            <div
              class:list={[
                "absolute left-3.5 -translate-x-1/2 w-8 aspect-square rounded-full bg-gradient-to-r from-red-900 to-red-700 border-4 border-white shadow-md",
                index % 2 === 1 &&
                  "lg:left-auto lg:right-3.5 lg:translate-x-1/2",
              ]}
            />
            <motion.div
              client:load
              initial={{ opacity: 0, y: -10 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.6, delay: 0.25 }}
              className="bg-white p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow"
            >
              <div class="flex flex-wrap items-center justify-between gap-x-2">
                <div class="flex items-center gap-2 grow">
                  <h4 class="text-sm font-medium text-gray-600">
                    {event.company}
                  </h4>
                  <span class="text-sm font-medium text-gray-700">&bull;</span>
                  <time class="text-sm font-medium text-gray-500">
                    {event.date}
                  </time>
                </div>
                <h4 class="text-sm font-medium text-gray-600">
                  {event.location}
                </h4>
              </div>
              <h3 class="mt-2 text-lg font-semibold text-gray-900">
                {event.title}
              </h3>
              <p class="mt-2 text-gray-600">{event.description}</p>
              {event.linkedContent && (
                <div class="w-full mt-2 flex items-center justify-end pe-2">
                  <a
                    href={event.linkedContent}
                    target="_blank"
                    class="text-sm text-red-700 hover:underline hover:text-red-600 transition-colors duration-200"
                  >
                    Learn More
                  </a>
                </div>
              )}
            </motion.div>
          </div>
        ))
      }
    </div>
  </div>
</section>
