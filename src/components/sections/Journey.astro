---
import stops from "../../content/journey.json";
import { useI18n } from "../../i18n";

const { t, lang } = useI18n(Astro.url);

// The CV as a corridor you travel east. Page scroll drives it while the
// section is pinned; see src/scripts/orbit.ts.
---

<section id="journey">
  <!-- Pinned while the corridor travels, plus a rest at each end, then
       released: the page's scroll turns sideways while it is on it. orbit.ts
       sets the section's height. -->
  <div class="pin">
    <div
      class="glow"
      style="background:radial-gradient(62% 32% at 86% 30%, color-mix(in srgb, var(--signal) 8%, transparent), transparent 64%)"
    >
    </div>

    <div>
  <header class="head" data-rise>
      <div class="title">
        <p class="eyebrow">{t.journey.eyebrow}</p>
        <h2 class="headline" set:html={t.journey.headline} />
      </div>
      <p class="lead note">{t.journey.note}</p>
    </header>
  </div>

    <div id="jStage">
      <div class="frame">
        <!-- Outside the scroller so it stays put while the cards move. Its
             baseline sits exactly on the axis rule. -->
        <div class="ridge" aria-hidden="true"></div>

        <div id="corridor">
          <div id="corridorTrack">
            <ol class="cards">
              {
                stops.map((s) => (
                  <li
                    class:list={[{ next: s.next }]}
                    data-card
                    data-leuven={s.en.name.startsWith("Leuven") || undefined}
                    style={`--w:${s.w}px;--size:${s.size}px;--msize:${s.mSize}px`}
                  >
                    <span class="year" style={s.yearRed ? "color:var(--signal)" : ""}>
                      {s[lang].year}
                    </span>
                    <span class="name">{s[lang].name}</span>
                    {s[lang].pitch && <span class="pitch">{s[lang].pitch}</span>}
                    <span class="detail">
                      {s[lang].detail.map((d) => (
                        <span>{d}</span>
                      ))}
                    </span>
                  </li>
                ))
              }
            </ol>

            <div class="axis" aria-hidden="true">
              {
                stops.map((s) => (
                  <div
                    class:list={[{ next: s.next }]}
                    style={`--w:${s.w}px${s.tickRed ? ";color:var(--signal)" : ""}`}
                  >
                    {s.tick}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop: the whole trip as one line. The copper fill and its marker
           follow the corridor's own scroll timeline. -->
      <div class="route" aria-hidden="true">
        <span>CUNEO</span>
        <div class="route-line"><i></i><b></b><em>LEUVEN</em></div>
        <span>2026 →</span>
      </div>

      <!-- Phone only: one stop per screen, so a counter replaces the widening
           card widths as the sense of travel. -->
      <div class="counter" aria-hidden="true">
        <div class="counter-rule"><div id="corrFill"></div></div>
        <span id="corrLabel">01 / 07</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* No overflow clipping here, or anywhere between the pin and the page:
     WebKit clips a pinned element through a layer of its own, placed where
     the main thread last saw the scroll, and the pinned section shook up and
     down with it. The corridor clips its own cards. */
  #journey {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--hair);
  }

  .pin {
    position: sticky;
    top: 0;
    min-height: 100vh;
    padding: var(--pad-y) 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 44px;
  }

  .head {
    padding: 0 var(--pad-x);
    display: flex;
    align-items: flex-end;
    gap: 24px clamp(32px, 4vw, 64px);
    flex-wrap: wrap;
  }

  .head p {
    margin: 0;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }


  /* Sits right beside the headline, level with its last line. */
  .note {
    max-width: 36ch;
    font-size: 17px;
    line-height: 1.55;
    margin-bottom: 0.45em;
  }

  .frame {
    position: relative;
  }

  /* Moved by the page's scroll, not the user's, once the script runs; until
     then it swipes like any overflow. The end padding lives on the track, not
     here: browsers disagree on whether a scroller's own end padding can be
     scrolled to. */
  #corridor {
    position: relative;
    z-index: 1;
    overflow-x: auto;
    overflow-y: hidden;
    padding-left: var(--pad-x);
    scrollbar-width: none;
  }

  /* `clip` over `hidden`: the cards are moved, never scrolled, so this needs
     no scroll container. `hidden` first for browsers without `clip`. */
  :global(.js) #corridor {
    overflow: hidden;
    overflow: clip;
  }

  #corridor::-webkit-scrollbar {
    display: none;
    height: 0;
  }

  .ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 23px;
    height: clamp(56px, 7vw, 84px);
    z-index: 0;
    pointer-events: none;
    /* Loses opacity left to right: the relief flattening as the ground opens. */
    background: linear-gradient(
      90deg,
      rgba(238, 235, 228, 0.15),
      rgba(238, 235, 228, 0.09) 62%,
      rgba(238, 235, 228, 0.04)
    );
    clip-path: polygon(
      0 100%,
      0 34%,
      5% 6%,
      10% 40%,
      15% 14%,
      21% 46%,
      27% 24%,
      33% 54%,
      39% 36%,
      45% 62%,
      51% 48%,
      57% 70%,
      63% 58%,
      69% 78%,
      75% 70%,
      81% 86%,
      87% 82%,
      93% 92%,
      100% 90%,
      100% 100%
    );
  }

  /* Both rows sit inside the one moved element, or the ticks slide against
     the cards. */
  #corridorTrack {
    width: max-content;
    padding-right: var(--pad-x);
  }

  /* The page's scroll moves the cards itself, in the same frame, with no
     script in between. orbit.ts sizes the section and sets the variables and
     the easing, and moves the track where this is not supported. The guard
     matters: a browser that ignores the timeline would otherwise play this as
     a zero-length animation and park the cards at the end. */
  @supports (animation-timeline: view()) {
    #journey {
      view-timeline: --journey block;
    }

    :global(.js) #corridorTrack {
      animation: journey-travel linear both;
      animation-timeline: --journey;
      animation-range: contain var(--j-start, 0px) contain
        calc(100% - var(--j-end, 0px));
    }
  }

  /* Twins: orbit.ts swaps between them to rebuild the animation when the
     variables change (see measureCorridor). */
  @keyframes journey-travel {
    to {
      transform: translate3d(calc(-1 * var(--j-travel, 0px)), 0, 0);
    }
  }

  @keyframes journey-travel-b {
    to {
      transform: translate3d(calc(-1 * var(--j-travel, 0px)), 0, 0);
    }
  }

  .cards {
    display: flex;
    align-items: flex-end;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    user-select: none;
  }

  /* `width`, never `flex-basis`: WebKit sizes a `max-content` flex container
     from its items' content, ignoring a basis wider than that — the track came
     out 288px short of the cards standing in it, and the corridor stopped with
     the last stop still off screen. The axis was worse: its ticks are four
     characters, so that row measured 323px. */
  .cards li {
    flex: none;
    width: var(--w);
    border-left: 1px solid var(--hair-3);
    padding: 0 18px 40px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: flex-end;
    min-height: 300px;
    /* Never transition transform here — it lags the scroll. */
    transition: opacity 180ms linear;
  }

  .cards li.next {
    border-left: 1px dashed var(--signal);
    gap: 14px;
  }

  .year {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .next .year {
    color: var(--signal);
  }

  /* `pre-line` so a "\n" in a name in journey.json breaks the line. */
  .name {
    font-size: var(--size);
    font-weight: 700;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    line-height: 1.04;
    white-space: pre-line;
  }

  .next .name {
    font-stretch: 82%;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .pitch {
    font-size: 17px;
    line-height: 1.5;
    max-width: 340px;
    text-wrap: pretty;
  }

  .detail {
    display: flex;
    flex-direction: column;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.75;
    letter-spacing: 0.04em;
    color: var(--warm);
    padding-top: 4px;
  }

  .axis {
    display: flex;
    width: max-content;
    border-top: 1px solid var(--hair-3);
    margin-top: 26px;
    user-select: none;
  }

  .axis > div {
    flex: none;
    width: var(--w);
    border-left: 1px solid var(--hair-3);
    padding: 9px 0 0 16px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .axis > div.next {
    border-left: 1px dashed var(--signal);
    color: var(--signal);
  }

  .counter {
    display: none;
  }

  .route {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 34px var(--pad-x) 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  .route-line {
    position: relative;
    flex: 1;
    height: 1px;
    background: var(--hair-3);
  }

  .route-line i {
    position: absolute;
    inset: -1px 0 auto 0;
    height: 3px;
    background: var(--signal);
    transform-origin: left;
    transform: scaleX(0);
    box-shadow: 0 0 12px color-mix(in srgb, var(--signal) 55%, transparent);
  }

  /* Sits where the Leuven stop reaches the left edge, so the marker lands on
     it as the move happens; the line carries on after it. orbit.ts sets the
     fraction. */
  .route-line em {
    position: absolute;
    top: 0;
    left: calc(var(--j-leuven, 0.6) * 100%);
    padding-top: 12px;
    white-space: nowrap;
    font-style: normal;
    color: var(--warm);
    transform: translateX(-50%);
  }

  .route-line em::before {
    content: "";
    position: absolute;
    top: -4px;
    left: 50%;
    width: 1px;
    height: 9px;
    background: var(--warm);
  }

  .route-line b {
    position: absolute;
    top: -4px;
    left: 0;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--signal) 22%, transparent);
  }

  @supports (animation-timeline: view()) {
    :global(.js) .route-line i,
    :global(.js) .route-line b {
      animation: route-go linear both;
      animation-timeline: --journey;
      animation-range: contain var(--j-start, 0px) contain
        calc(100% - var(--j-end, 0px));
    }

    :global(.js) .route-line b {
      animation-name: route-dot;
    }
  }

  @keyframes route-go {
    to { transform: scaleX(1); }
  }

  @keyframes route-dot {
    to { left: 100%; }
  }

  @media (max-width: 768px) {
    .pin {
      padding: 64px 0 72px;
      gap: 28px;
    }

    .head {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .ridge {
      bottom: 22px;
      height: 56px;
    }

    /* One stop per screen, and never wider than the corridor on a narrow
       phone. `min-width` drops flexbox's automatic minimum so content can
       never push a card back out past that. Cards and ticks share the rule:
       if the two ever disagree the axis desyncs from the stops. */
    .cards li,
    .axis > div {
      width: min(300px, calc(100vw - 2 * var(--pad-x)));
      min-width: 0;
    }

    .cards li {
      padding: 0 20px 34px 14px;
    }

    .name {
      font-size: var(--msize);
      line-height: 1.06;
    }

    .next .name {
      line-height: 1;
    }

    .pitch {
      font-size: 16px;
      max-width: none;
    }

    .detail {
      line-height: 1.8;
    }

    .next .detail {
      font-size: 10px;
      padding-top: 0;
    }

    .axis {
      margin-top: 22px;
    }

    .axis > div {
      padding: 8px 0 0 14px;
      font-size: 10px;
    }

    .route {
      display: none;
    }

    .counter {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 20px 0;
    }

    .counter-rule {
      flex: 1;
      height: 1px;
      background: var(--hair-3);
      position: relative;
    }

    #corrFill {
      position: absolute;
      left: 0;
      top: -1px;
      height: 3px;
      width: 0;
      background: var(--signal);
    }

    .counter span {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      color: var(--dim);
    }
  }
</style>
