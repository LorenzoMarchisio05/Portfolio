---
import { getCollection } from "astro:content";

const svgs = await getCollection("skills").then((collection) =>
  collection.map((x) => x.data)
);

let index = 0;

const dotsBaseSize = 60;
const totalDots = svgs.length;

// Base configuration
const baseRadius = dotsBaseSize * 2;
const radiusIncrement = dotsBaseSize * 2;

// Calculate optimal number of circles based on dot spacing
function calculateOptimalCircleCount() {
  let circleCount = 1;
  let dotsPlaced = 0;

  while (dotsPlaced < totalDots) {
    const radius = baseRadius + (circleCount - 1) * radiusIncrement;
    const circumference = 2 * Math.PI * radius;

    // Calculate dots and ensure it's odd by rounding down to nearest odd number
    let dotsOnCircle = Math.floor(circumference / dotsBaseSize);
    dotsOnCircle = dotsOnCircle % 2 === 0 ? dotsOnCircle - 1 : dotsOnCircle;

    dotsPlaced += dotsOnCircle;

    if (dotsPlaced >= totalDots || circleCount >= 10) {
      break;
    }

    circleCount++;
  }

  return circleCount;
}

// Get the optimal number of circles
const circleCount = calculateOptimalCircleCount();

// Calculate circumferences for each circle
const circumferences = Array.from({ length: circleCount }).map((_, i) => {
  const radius = baseRadius + i * radiusIncrement;
  return 2 * Math.PI * radius;
});

// Calculate total circumference
const totalCircumference = circumferences.reduce((sum, c) => sum + c, 0);

// Distribute dots proportionally to circumference
const dotsPerCircle = circumferences.map((circumference) => {
  return Math.round((circumference / totalCircumference) * totalDots);
});

// Ensure we have exactly the total number of dots
dotsPerCircle[circleCount - 1] +=
  totalDots - dotsPerCircle.reduce((sum, count) => sum + count, 0);
---

<section
  id="skills"
  class="min-h-screen w-full relative perspective-midrange overflow-hidden flex flex-col lg:flex-row px-6 sm:px-12 lg:px-20"
>
  <div
    class="hidden lg:block absolute left-0 top-0 w-2/3 h-full -z-10 bg-dotted rotate-y-[16deg] -translate-z-96 origin-right"
  >
  </div>

  <div class="relative space-y-6 lg:space-y-8 pt-24 pb-10 lg:py-24 lg:px-2">
    <h2
      class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tighter text-gray-900"
    >
      Technical Skills
    </h2>
    <h3
      class="text-xl sm:text-2xl lg:text-3xl font-semibold bg-gradient-to-l from-5% from-gray-900 to-red-700 bg-clip-text text-transparent"
    >
      Expertise & Technologies
    </h3>
    <div class="space-y-8">
      <p class="text-base sm:text-lg lg:text-xl text-gray-700 max-w-2xl leading-relaxed">
        Proficient in a wide range of modern technologies and frameworks, with a
        focus on delivering scalable and efficient solutions.
      </p>
      <p class="text-base lg:text-lg text-gray-700 max-w-2xl leading-relaxed">
        Continuously expanding knowledge across the full stack development
        spectrum, from frontend design to backend architecture.
      </p>
    </div>
    <div class="flex flex-wrap gap-4 sm:gap-6 mt-10 lg:mt-16">
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 sm:px-8 py-3 rounded-lg font-medium tracking-wide text-red-800 border border-red-800/25 bg-white/70 shadow-sm hover:bg-white hover:border-red-800/50 transition"
      >
        Take a look at my CV
      </a>
      <a
        href="#contact"
        class="px-6 sm:px-8 py-3 rounded-lg font-medium tracking-wide text-white bg-gradient-to-r from-red-900 to-red-700 shadow-lg hover:from-red-800 hover:to-red-600 transition"
      >
        Get in touch
      </a>
    </div>
  </div>
  <div
    class="w-full relative min-h-[380px] sm:min-h-[560px] lg:min-h-0 scale-[0.6] sm:scale-90 lg:scale-100"
  >
    {
      Array.from({ length: circleCount }).flatMap((_, circleIndex) => {
        const currentDotsCount = dotsPerCircle[circleIndex];
        const currentRadius = baseRadius + circleIndex * radiusIncrement;
        const duration = 15 + (50 / (circleIndex + 1)) * circleIndex;

        return (
          <div
            class:list={[
              "absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2",
              circleIndex % 2 === 1 && "orbit-reverse",
            ]}
            style={`--orbit-duration:${duration}s`}
          >
            {/* The centring translate and the spin live on separate elements so
                the rotation keyframe does not clobber the translate. */}
            <div class="orbit-ring rounded-full origin-center">
              {Array.from({ length: currentDotsCount }).map((_, dotIndex) => {
                const angle = (dotIndex / currentDotsCount) * 2 * Math.PI;

                const dotSize = dotsBaseSize - circleIndex * 2;

                const x = Math.cos(angle) * currentRadius;
                const y = Math.sin(angle) * currentRadius;

                index++;

                return (
                  <div
                    class="absolute rounded-full aspect-square"
                    style={{
                      width: `${dotSize}px`,
                      left: `${x}px`,
                      top: `${y}px`,
                      transform: `translate(-${dotSize / 2}px, -${dotSize / 2}px)`,
                    }}
                  >
                    <img
                      src={svgs[index % svgs.length].logo}
                      alt={svgs[index % svgs.length].name}
                      loading="lazy"
                      decoding="async"
                      class="orbit-logo w-full h-full rounded-full object-cover object-center"
                    />
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
