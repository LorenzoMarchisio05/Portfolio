---
import Silhouette from "../components/Silhouette.astro";
import { useI18n } from "../../i18n";

const { t, href } = useI18n(Astro.url);
---

<section id="founder" class="section">
  <div class="backdrop" aria-hidden="true">
    <div class="backdrop-box" data-par="-.12" data-par-m="-.1">
      <div class="tilt">
        <Silhouette
          kind="nodes"
          color="rgba(238,235,228,.3)"
          line="rgba(160,196,220,.14)"
        />
      </div>
    </div>
  </div>
  <div class="glow founder-glow"></div>

  <div data-par=".03" data-par-m="0">
    <div class="head" data-rise>
      <div class="title">
        <p class="eyebrow">120° · {t.roles.founder}</p>
        <p class="statement">{t.founder.statement}</p>
      </div>
      <h2 class="big" set:html={t.founder.headline} />
    </div>
  </div>

  <ol class="activities">
    <li data-par=".04" data-par-m="0">
      <div class="activity" data-rise>
        <p class="num">{t.founder.studio.label}</p>
        <h3 class="name">{t.founder.studio.title}</h3>
        <p class="first">{t.founder.studio.text}</p>
        <a class="go" href={href("/websites")}>{t.founder.studio.link}</a>
      </div>
    </li>

    <li data-par=".04" data-par-m="0">
      <div class="activity" data-rise>
        <p class="num">{t.founder.unnamed.label}</p>
        <h3 class="name">{t.founder.unnamed.title}</h3>
        <div class="cols">
          <p class="first">{t.founder.unnamed.first}</p>
          <p class="second">{t.founder.unnamed.second}</p>
        </div>
      </div>
    </li>
  </ol>
</section>

<style>
  #founder {
    overflow: clip;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .backdrop-box {
    position: sticky;
    top: var(--sticky);
    width: min(780px, 70vw);
    aspect-ratio: 1;
    flex: 0 0 auto;
    align-self: flex-start;
  }

  .tilt {
    position: absolute;
    inset: 8% 6%;
    transform: perspective(1100px) rotateY(12deg) rotateX(-5deg);
  }

  .founder-glow {
    background: radial-gradient(
      58% 34% at 14% 22%,
      rgba(255, 47, 29, 0.09),
      transparent 64%
    );
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 4vh, 44px);
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .title p {
    margin: 0;
  }

  .statement {
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 500;
    font-stretch: 86%;
    letter-spacing: -0.02em;
    line-height: 1.12;
    max-width: 620px;
    text-wrap: pretty;
  }

  .big {
    margin: 0;
    font-size: clamp(44px, 8vw, 104px);
    font-weight: 700;
    font-stretch: 79%;
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  .activities {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vh, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 1100px;
  }

  .activity {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--hair-3);
  }

  .activity > p {
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--signal);
  }

  .name {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .go {
    width: fit-content;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 6px;
  }

  .cols {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    max-width: 1100px;
  }

  .cols p {
    flex: 1;
    min-width: 280px;
    margin: 0;
    text-wrap: pretty;
  }

  .first {
    font-size: 19px;
    line-height: 1.55;
  }

  .second {
    font-size: 17px;
    line-height: 1.6;
    color: var(--warm);
  }

  @media (max-width: 768px) {
    .backdrop-box {
      top: 96px;
      width: min(520px, 112vw);
      opacity: 0.6;
    }

    .tilt {
      transform: perspective(900px) rotateY(12deg) rotateX(-4deg);
    }

    .founder-glow {
      background: radial-gradient(
        74% 28% at 12% 20%,
        rgba(255, 47, 29, 0.09),
        transparent 66%
      );
    }

    .head {
      gap: 22px;
    }

    .title {
      gap: 22px;
    }

    .statement {
      font-size: 22px;
      line-height: 1.16;
    }

    .big {
      font-size: clamp(40px, 12vw, 60px);
    }

    .cols {
      flex-direction: column;
      gap: 20px;
    }

    .activities {
      gap: 36px;
    }

    .name {
      font-size: 26px;
    }

    .go {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-bottom: 0;
    }

    .cols p {
      min-width: 0;
    }

    .first {
      font-size: 17px;
    }

    .second {
      font-size: 16px;
    }
  }
</style>
