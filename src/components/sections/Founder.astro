---
import Silhouette from "../components/Silhouette.astro";
import { useI18n } from "../../i18n";

const { t, href } = useI18n(Astro.url);
// Product screenshots shown as decoration beside each card, front one last.
const shots = {
  volstead: ["4-specs", "2-build-it", "1-today"].map((f) => `/projects/volstead-${f}.webp`),
  aditus: ["04-tab-search", "01-tabs-sidebar"].map((f) => `/projects/aditus-${f}.webp`),
};
---

<section id="founder" class="section">
  <div class="backdrop" aria-hidden="true">
    <div class="backdrop-box" data-par="-.12" data-par-m="-.1">
      <div class="tilt">
        <Silhouette
          kind="nodes"
          color="rgba(238,235,228,.3)"
          line="rgba(160,196,220,.14)"
        />
      </div>
    </div>
  </div>
  <div class="glow founder-glow"></div>

  <div data-par=".03" data-par-m="0">
    <div class="head" data-rise>
      <div class="title">
        <p class="eyebrow">120° · {t.roles.founder}</p>
        <p class="statement">{t.founder.statement}</p>
      </div>
      <h2 class="big" set:html={t.founder.headline} />
    </div>
  </div>

  <ol class="activities">
    {
      (["volstead", "aditus"] as const).map((id) => (
        <li data-par=".04" data-par-m="0">
          <div class="activity" data-rise data-lit>
            <p class="num">{t.founder[id].label}</p>
            <h3 class="name">{t.founder[id].title}</h3>
            <p class="first">{t.founder[id].text}</p>
            <a class="go" href={href(`/projects/${id}`)}>{t.founder[id].link}</a>
            <div class={`visual ${id}`} aria-hidden="true">
              {shots[id].map((src) => <img src={src} alt="" loading="lazy" decoding="async" />)}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  #founder {
    overflow: clip;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .backdrop-box {
    position: sticky;
    top: var(--sticky);
    width: min(780px, 70vw);
    aspect-ratio: 1;
    flex: 0 0 auto;
    align-self: flex-start;
  }

  .tilt {
    position: absolute;
    inset: 8% 6%;
    transform: perspective(1100px) rotateY(12deg) rotateX(-5deg);
  }

  .founder-glow {
    background: radial-gradient(
      58% 34% at 14% 22%,
      color-mix(in srgb, var(--signal) 9%, transparent),
      transparent 64%
    );
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 4vh, 44px);
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .title p {
    margin: 0;
  }

  .statement {
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 500;
    font-stretch: 86%;
    letter-spacing: -0.02em;
    line-height: 1.12;
    max-width: 620px;
    text-wrap: pretty;
  }

  .big {
    margin: 0;
    font-size: clamp(44px, 8vw, 104px);
    font-weight: 700;
    font-stretch: 79%;
    letter-spacing: -0.035em;
    line-height: 0.9;
  }

  .activities {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vh, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 1240px;
  }

  .activity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-rows: 1fr repeat(4, min-content) 1fr;
    gap: 14px clamp(24px, 5vw, 72px);
    padding-top: 22px;
    border-top: 1px solid var(--hair-3);
  }

  .activity > :not(.visual) {
    grid-column: 1;
  }

  /* Text sits between two spacer rows, so it centres beside the taller visual. */
  .num { grid-row: 2; }
  .activity > .name { grid-row: 3; }
  .first { grid-row: 4; }
  .go { grid-row: 5; }

  /* Screenshots: a fan of phones for Volstead, a stack of windows for Aditus. */
  .visual {
    grid-column: 2;
    grid-row: 1 / -1;
    position: relative;
    height: clamp(260px, 30vw, 400px);
    pointer-events: none;
  }

  li:nth-child(even) .activity > :not(.visual) {
    grid-column: 2;
  }

  li:nth-child(even) .visual {
    grid-column: 1;
  }

  .visual img {
    position: absolute;
    border: 1px solid var(--hair-3);
    box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.95);
    transition:
      translate 520ms var(--ease),
      rotate 520ms var(--ease);
  }

  .visual.volstead img {
    width: 36%;
    height: auto;
    bottom: 0;
    left: 32%;
    border-radius: 16px;
  }

  .visual.volstead img:nth-child(1) { rotate: -9deg; translate: -78% 4%; }
  .visual.volstead img:nth-child(2) { rotate: -1deg; translate: -4% -4%; }
  .visual.volstead img:nth-child(3) { rotate: 8deg; translate: 72% 2%; }

  .activity:hover .visual.volstead img:nth-child(1) { rotate: -13deg; translate: -96% 6%; }
  .activity:hover .visual.volstead img:nth-child(2) { rotate: -3deg; translate: -10% -8%; }
  .activity:hover .visual.volstead img:nth-child(3) { rotate: 12deg; translate: 92% 4%; }

  .visual.aditus img {
    width: 82%;
    height: auto;
    border-radius: 10px;
  }

  .visual.aditus img:nth-child(1) { top: 0; right: 0; opacity: 0.7; translate: 0 0; }
  .visual.aditus img:nth-child(2) { bottom: 0; left: 0; translate: 0 0; }
  .activity:hover .visual.aditus img:nth-child(1) { translate: 14px -12px; }
  .activity:hover .visual.aditus img:nth-child(2) { translate: -10px 10px; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .visual {
        animation: visual-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }

  @keyframes visual-in {
    from { opacity: 0; translate: 0 48px; scale: 0.94; }
  }

  @media (prefers-reduced-motion: reduce) {
    .visual img { transition: none; }
  }

  .activity > p {
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--signal);
  }

  .name {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    font-stretch: 84%;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .go {
    width: fit-content;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 6px;
  }


  @media (prefers-reduced-motion: no-preference) {
    .name {
      transition: translate 360ms var(--ease);
    }

    .activity:hover .name {
      translate: 10px 0;
    }

    /* The backdrop graph drifts against the scroll: a slow turn, no loop. */
    @supports (animation-timeline: scroll()) {
      .tilt {
        animation: founder-turn linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes founder-turn {
    from { rotate: 0deg; scale: 0.94; }
    to { rotate: 6deg; scale: 1.04; }
  }

  .first {
    font-size: 19px;
    line-height: 1.55;
  }


  @media (max-width: 768px) {
    .activity {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .num,
    .activity > .name,
    .first,
    .go {
      grid-row: auto;
    }

    .activity > :not(.visual),
    li:nth-child(even) .activity > :not(.visual),
    .visual,
    li:nth-child(even) .visual {
      grid-column: 1;
    }

    .visual {
      grid-row: auto;
      height: min(64vw, 300px);
      margin-top: 18px;
    }

    .backdrop-box {
      top: 96px;
      width: min(520px, 112vw);
      opacity: 0.6;
    }

    .tilt {
      transform: perspective(900px) rotateY(12deg) rotateX(-4deg);
    }

    .founder-glow {
      background: radial-gradient(
        74% 28% at 12% 20%,
        color-mix(in srgb, var(--signal) 9%, transparent),
        transparent 66%
      );
    }

    .head {
      gap: 22px;
    }

    .title {
      gap: 22px;
    }

    .statement {
      font-size: 22px;
      line-height: 1.16;
    }

    .big {
      font-size: clamp(40px, 12vw, 60px);
    }


    .activities {
      gap: 36px;
    }

    .name {
      font-size: 26px;
    }

    .go {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-bottom: 0;
    }


    .first {
      font-size: 17px;
    }

  }
</style>
