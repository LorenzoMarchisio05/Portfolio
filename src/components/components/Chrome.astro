---
// Fixed chrome: the bar with the live angle readout, and the scroll progress
// rule pinned to the bottom of the viewport (the top, on a phone).
import LangMenu from "./LangMenu.astro";
import { useI18n } from "../../i18n";

const { t } = useI18n(Astro.url);
const links = [
  { href: "#engineer", label: t.roles.engineer },
  { href: "#founder", label: t.roles.founder },
  { href: "#photography", label: t.roles.photographer },
];
---

<div class="bar">
  <a class="wordmark" href="#top">LM<span>.</span></a>
  <nav class="links">
    {
      links.map(({ href, label }) => (
        <a href={href} data-nav={href.slice(1)}>
          {label}
        </a>
      ))
    }
  </nav>
  <div class="lang"><LangMenu><span data-angle>068°</span></LangMenu></div>
</div>

<div class="progress">
  <div id="progFill"></div>
</div>

<style>
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 26px var(--pad-x);
    background: linear-gradient(var(--ink) 62%, rgba(12, 11, 10, 0));
    /* The bar itself must not eat clicks on the page behind it. */
    pointer-events: none;
  }

  .wordmark {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    pointer-events: auto;
  }

  .wordmark span {
    color: var(--signal);
  }

  .links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 34px);
    pointer-events: auto;
  }

  .links a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
  }

  .links a[data-active] {
    color: var(--signal);
  }

  .progress {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    z-index: 41;
    background: rgba(242, 239, 233, 0.08);
    pointer-events: none;
  }

  /* Scaled, not resized: the fill changes every frame of a scroll, and a
     transform does not lay the page out again. */
  .progress > div {
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* A rule pinned to the bottom rides a phone browser's toolbar as it slides
     in and out, and jumps with it. The top edge never moves. */
  @media (max-width: 768px), (pointer: coarse) {
    .progress {
      top: 0;
      bottom: auto;
    }
  }

  @media (max-width: 768px) {
    .bar {
      gap: 16px;
      padding: 16px 20px 20px;
      background: linear-gradient(var(--ink) 58%, rgba(12, 11, 10, 0));
    }

    .wordmark {
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-right: 10px;
    }

    /* The phone design drops the section links: only the wordmark and the
       angle readout, which holds the languages, survive. */
    .links {
      display: none;
    }

    .lang {
      margin-left: auto;
    }
  }
</style>
