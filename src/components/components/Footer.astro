---
// One footer for every page. Its side padding follows the page's column:
// the websites pages set --footer-x to their centered gutter.
import { useI18n } from "../../i18n";

const { t, href } = useI18n(Astro.url);
const links = [
  [href("/"), t.footer.home],
  [href("/gallery"), t.footer.gallery],
  [href("/privacy"), t.footer.privacy],
];
// The home link ends in a slash ("/en/"), so both sides drop it.
const bare = (path: string) => path.replace(/\/$/, "");
const here = bare(Astro.url.pathname);
---

<footer>
  <p class="mark" aria-hidden="true">LORENZO MARCHISIO</p>
  <span>© 2026 LORENZO MARCHISIO</span>
  <nav aria-label={t.footer.label}>
    {
      links.map(([link, label]) => (
        <a href={link} aria-current={bare(link) === here ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .mark {
    flex: 1 0 100%;
    margin: 0 0 18px;
    font-family: var(--sans, inherit);
    font-size: clamp(40px, 11.4vw, 190px);
    font-weight: 700;
    font-stretch: 78%;
    letter-spacing: -0.035em;
    line-height: 0.85;
    white-space: nowrap;
    overflow: clip;
    color: transparent;
    -webkit-text-stroke: 1px rgba(242, 239, 233, 0.22);
    background: linear-gradient(90deg, var(--bone) 50%, transparent 50%) 100% 0 / 200% 100% no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
  }

  /* The outline fills with bone as the footer scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mark {
        animation: mark-fill linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }

  @keyframes mark-fill {
    to { background-position: 0 0; }
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 30px var(--footer-x, var(--pad-x)) 44px;
    border-top: 1px solid var(--hair);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  a {
    color: var(--warm);
    text-transform: uppercase;
  }

  a:hover {
    color: var(--signal);
  }

  [aria-current] {
    color: var(--bone);
  }

  @media (max-width: 768px) {
    footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 26px var(--footer-x, var(--pad-x)) 40px;
    }
  }
</style>
