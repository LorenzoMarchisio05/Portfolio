---
// Custom cursor component for the portfolio
---

<div
    id="cursor-shadow"
    class="hidden lg:block fixed z-40 left-1/2 -top-1/2 w-10 aspect-square rounded-[50%] bg-red-500/30 pointer-events-none"
>
</div>

<div
    id="cursor"
    class="hidden lg:block fixed z-50 left-1/2 -top-1/2 w-3 aspect-square rounded-[50%] bg-black pointer-events-none"
>
</div>

<script>
    // A trailing cursor is a lerp towards the pointer, so this needs no
    // animation library: the dot tracks tightly, the shadow lags behind it.
    const shadow = document.getElementById("cursor-shadow")!;
    const dot = document.getElementById("cursor")!;

    // The elements park offscreen until the first move, so nothing to show
    // on a device that never sends one.
    if (matchMedia("(pointer: fine)").matches) {
        const centre = (el: HTMLElement) => {
            const rect = el.getBoundingClientRect();
            return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        };

        const shadowOrigin = centre(shadow);
        const dotOrigin = centre(dot);

        const SHADOW_EASE = 0.15;
        const DOT_EASE = 0.55;

        let pointerX = 0;
        let pointerY = 0;
        let shadowX = 0;
        let shadowY = 0;
        let dotX = 0;
        let dotY = 0;
        let running = false;

        const tick = () => {
            const shadowDX = pointerX - shadowOrigin.x - shadowX;
            const shadowDY = pointerY - shadowOrigin.y - shadowY;
            const dotDX = pointerX - dotOrigin.x - dotX;
            const dotDY = pointerY - dotOrigin.y - dotY;

            shadowX += shadowDX * SHADOW_EASE;
            shadowY += shadowDY * SHADOW_EASE;
            dotX += dotDX * DOT_EASE;
            dotY += dotDY * DOT_EASE;

            shadow.style.transform = `translate(${shadowX}px, ${shadowY}px)`;
            dot.style.transform = `translate(${dotX}px, ${dotY}px)`;

            // Park the loop once it has caught up, rather than burning a frame
            // every 16ms while the pointer sits still.
            const settled =
                Math.abs(shadowDX) < 0.1 &&
                Math.abs(shadowDY) < 0.1 &&
                Math.abs(dotDX) < 0.1 &&
                Math.abs(dotDY) < 0.1;

            running = !settled;
            if (running) requestAnimationFrame(tick);
        };

        document.addEventListener("mousemove", (event) => {
            pointerX = event.clientX;
            pointerY = event.clientY;

            if (!running) {
                running = true;
                requestAnimationFrame(tick);
            }
        });
    }
</script>
