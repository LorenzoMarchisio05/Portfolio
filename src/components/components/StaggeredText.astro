---
interface Props {
  text: string;
  duration: number;
  delay?: number;
}

const { text, duration, delay = 0 } = Astro.props;

// Plain inline spans on purpose: the headings that use this are painted with
// `bg-clip-text`, and an ancestor's text clip does not reach glyphs inside
// inline-block descendants. That also rules out transforms here, so the
// animation is a fade (which is all the previous version ever rendered).
const charDuration = duration / text.length;

const chars = text.split("").map((char, index) => ({
  char,
  style: `animation-duration:${charDuration}s;animation-delay:${index * 0.05 + delay}s`,
}));
---

{
  chars.map(({ char, style }) => (
    <span class="stagger-char" style={style}>
      {char}
    </span>
  ))
}
