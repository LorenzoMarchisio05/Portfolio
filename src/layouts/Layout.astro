---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Share image path. 1200×630, like the default — the size meta below is fixed. */
  image?: string;
  /** Keep the page out of search results, while still following its links. */
  noindex?: boolean;
}

const {
  title = "Lorenzo Marchisio · Engineer, Founder, Photographer",
  description =
    "Nothing here resolves until you stand somewhere specific. There are three such places, and the shape is different from each one.",
  image = "/social/og-home.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const og = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0C0B0A" />

    <!-- Self-hosted, same origin: no third-party request on page load, which is
         what the contact form's NO TRACKING line promises. Only the latin
         subsets are preloaded — latin-ext loads on demand. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/archivo-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-latin.woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Lorenzo Marchisio" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      // Gates the reveal from-state on JS being alive: without this every
      // [data-rise] block would sit at opacity 0 forever when scripting is off.
      document.documentElement.classList.add("js");

      // No "Save image" menu and no drag-out on photographs. A deterrent for
      // casual saving only; the © mark burned into each file is what sticks.
      for (const type of ["contextmenu", "dragstart"]) {
        document.addEventListener(type, (event) => {
          if (event.target instanceof HTMLImageElement) event.preventDefault();
        });
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
