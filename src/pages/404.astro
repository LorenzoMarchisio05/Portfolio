---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found — Lorenzo Marchisio"
  description="That page doesn't exist."
>
  <main>
    <p class="eyebrow">404 · NO SUCH ANGLE</p>
    <h1 class="headline">NOTHING<br />RESOLVES HERE</h1>
    <p class="lead">
      The page you asked for does not exist, or has moved somewhere the object
      no longer reads from.
    </p>
    <a href="/">BACK TO 000° ↓</a>
  </main>
</Layout>

<style>
  main {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: 120px var(--pad-x) 56px;
    max-width: 720px;
  }

  main p {
    margin: 0;
  }

  a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 6px;
    width: fit-content;
  }
</style>
