---
import { readFile } from "node:fs/promises";
import { imageMetadata } from "astro/assets/utils";
import Layout from "../layouts/Layout.astro";

// Built once, not per request: the grid needs every photo's size, and only the
// build has the files on disk — the worker has no node:fs.
export const prerender = true;

// Grid rows are 2/3 of a column wide, so these spans land on the common ratios:
// 2×2 is 3:2, 1×2 is 3:4, 2×3 is square, 4×2 is 3:1. A photo in between is
// cropped a little to the nearest cell; the viewer always shows it whole.
const shape = (ratio: number) =>
  ratio >= 2.1 ? "pano" : ratio >= 1.2 ? "land" : ratio > 0.87 ? "square" : "port";

// Every photograph in /public/photos/, as written by scripts/photos.sh. Files
// are named `<number>-<category>[-more-words].webp`: `07-alpine-lake` is photo 7
// in ALPINE. Any number of digits, sorted numerically so 9 comes before 10; a
// two-word category takes an underscore, `08-street_food`. The words are only
// used as alt text — nothing from the filename is shown.
const photos = await Promise.all(
  Object.keys(import.meta.glob("/public/photos/*.webp"))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async (path) => {
      const { width, height } = await imageMetadata(await readFile(`.${path}`));
      const name = path.slice(path.lastIndexOf("/") + 1, -".webp".length);
      const [n, category = "", ...words] = name.split("-");
      const subject = [category, ...words].join(" ").replaceAll("_", " ");
      return {
        src: path.slice("/public".length),
        thumb: `/photos/thumbs/${name}.webp`,
        alt: subject ? `Photograph ${n}, ${subject}` : `Photograph ${n}`,
        category: category.replaceAll("_", " "),
        shape: shape(width / height),
      };
    }),
);

const categories = [...new Set(photos.map((p) => p.category).filter(Boolean))].sort();
const count = String(photos.length).padStart(2, "0");
---

<Layout
  title="Gallery · Lorenzo Marchisio"
  description="Motorcycle, football and travel photographs from Slovenia and Croatia, by Lorenzo Marchisio."
  image="/og-gallery.jpg"
>
  <header class="bar">
    <a class="wordmark" href="/">LM<span>.</span></a>
    <a class="back" href="/#photography">← BACK</a>
    <span class="angle">240°</span>
  </header>

  <main>
    <div class="glow"></div>

    <div class="intro">
      <p class="eyebrow">240° · PHOTOGRAPHER</p>
      <h1 class="headline">EVERY<br />FRAME</h1>
      <p class="lead">
        The grid rearranges itself to fit. Open a frame to see it whole.
      </p>
      <p class="meta">{count} FRAMES</p>
      {
        categories.length > 1 && (
          <div class="filters" role="group" aria-label="Filter by category">
            <button type="button" data-filter="" aria-pressed="true">
              ALL
            </button>
            {categories.map((c) => (
              <button type="button" data-filter={c} aria-pressed="false">
                {c.toUpperCase()}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <ul class="grid">
      {
        photos.map((p) => (
          <li class={p.shape} data-category={p.category}>
            <button class="shot" type="button" data-cursor="frame" data-full={p.src}>
              <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
            </button>
          </li>
        ))
      }
    </ul>
  </main>

  <dialog id="viewer" aria-label="Photograph">
    <button class="close" type="button">CLOSE ✕</button>
    <figure data-cursor="frame">
      <img alt="" />
      <span class="pip"></span>
    </figure>
    <p class="keys" aria-hidden="true">← → BROWSE · ESC CLOSE</p>
    <a class="remove" href="mailto:me@lorenzomarchisio.me">REQUEST REMOVAL</a>
  </dialog>
</Layout>

<script>
  const viewer = document.getElementById("viewer") as HTMLDialogElement;
  const big = viewer.querySelector("img")!;
  const remove = viewer.querySelector<HTMLAnchorElement>(".remove")!;
  const inbox = remove.href;
  const shots = Array.from(document.querySelectorAll<HTMLButtonElement>(".shot"));
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  let current = shots[0];

  // A filtered-out photo leaves the grid entirely, so the dense packing closes
  // the gap on its own.
  filters.forEach((filter) =>
    filter.addEventListener("click", () => {
      const category = filter.dataset.filter;
      filters.forEach((f) => f.setAttribute("aria-pressed", String(f === filter)));
      shots.forEach((shot) => {
        shot.parentElement!.hidden =
          category !== "" && shot.parentElement!.dataset.category !== category;
      });
    }),
  );

  const show = (shot: HTMLButtonElement) => {
    current = shot;
    big.src = shot.dataset.full!;
    big.alt = shot.querySelector("img")!.alt;
    // No server and no email quota: the request leaves from the visitor's own
    // mail app, already naming the photo, with an address to reply to.
    const name = shot.dataset.full!.slice("/photos/".length, -".webp".length);
    const subject = `Photo removal request: ${name}`;
    const body = `Photo: ${name}\n\nReason:\n`;
    remove.href = `${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  // Browses only what the filter shows, in filename order rather than the
  // grid's packed order, and wraps: → on the last frame goes back to the first.
  const step = (by: number) => {
    const shown = shots.filter((shot) => !shot.parentElement!.hidden);
    const at = shown.indexOf(current);
    show(shown[(at + by + shown.length) % shown.length]);
  };

  shots.forEach((shot) =>
    shot.addEventListener("click", () => {
      show(shot);
      viewer.showModal();
    }),
  );

  viewer.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight") step(1);
    if (event.key === "ArrowLeft") step(-1);
  });

  // A viewer, not an editor: the removal link is the only thing inside to
  // click, so any other click — the close button included — puts it away.
  // Escape is native to <dialog>.
  viewer.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".remove")) viewer.close();
  });

  // Land on the frame last viewed, not the one that opened the viewer.
  viewer.addEventListener("close", () => current.focus());
</script>

<style>
  /* Same bar as the home page, minus the section links and the live readout
     that only make sense on the orbit. */
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 26px var(--pad-x);
    background: linear-gradient(var(--ink) 62%, rgba(12, 11, 10, 0));
    pointer-events: none;
  }

  .bar a {
    pointer-events: auto;
  }

  .wordmark {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
  }

  .wordmark span {
    color: var(--signal);
  }

  .back {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
  }

  .angle {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--signal);
  }

  main {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-y);
    padding: clamp(130px, 18vh, 200px) var(--pad-x) var(--pad-y);
    /* The grid sizes its rows off this width. */
    container-type: inline-size;
  }

  main .glow {
    background: radial-gradient(
      56% 30% at 10% 12%,
      rgba(255, 47, 29, 0.07),
      transparent 64%
    );
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }

  .intro p {
    margin: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding-top: 6px;
  }

  .filters button {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 6px;
  }

  .filters button:hover {
    color: var(--signal);
  }

  .filters [aria-pressed="true"] {
    color: var(--bone);
    border-bottom-color: var(--signal);
  }

  /* Dense packing: when a photo does not fit the space left in a row, a later
     one that does moves up into it. That is what keeps rows full — and why the
     visual order drifts from the filename order. */
  .grid {
    --cols: 6;
    --gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: calc(
      (100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) * 2 / 3
    );
    grid-auto-flow: dense;
    gap: var(--gap);
  }

  .land {
    grid-column: span 2;
    grid-row: span 2;
  }

  .port {
    grid-row: span 2;
  }

  .square {
    grid-column: span 2;
    grid-row: span 3;
  }

  .pano {
    grid-column: span 4;
    grid-row: span 2;
  }

  .shot {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--frame-fill);
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0);
    transition: box-shadow 140ms var(--ease);
  }

  .shot:hover::after {
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.55);
  }

  /* ---- viewer ---- */

  :global(html:has(#viewer[open])) {
    overflow: hidden;
  }

  dialog {
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--pad-x);
    border: 0;
    background: rgba(12, 11, 10, 0.96);
    color: var(--bone);
  }

  dialog::backdrop {
    background: transparent;
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    animation: lm-view 320ms var(--ease) both;
  }

  figure {
    position: relative;
    margin: 0;
    box-shadow: 0 50px 140px rgba(0, 0, 0, 0.8);
  }

  figure::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.4);
  }

  figure img {
    display: block;
    max-width: calc(100vw - 2 * var(--pad-x));
    max-height: calc(100dvh - 160px);
  }

  .pip {
    position: absolute;
    right: 14px;
    top: 12px;
    width: 9px;
    height: 9px;
    background: var(--signal);
  }

  .keys {
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  /* No keyboard to press. */
  @media (pointer: coarse) {
    .keys {
      display: none;
    }
  }

  .close,
  .remove {
    position: absolute;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--warm);
    background: transparent;
    border: 1px solid var(--hair-4);
    padding: 12px 22px;
  }

  .close {
    top: 22px;
    right: var(--pad-x);
  }

  .remove {
    bottom: 22px;
    left: var(--pad-x);
  }

  .close:hover,
  .remove:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  @keyframes lm-view {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[open] {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .grid {
      --cols: 4;
    }
  }

  @media (max-width: 768px) {
    .bar {
      gap: 16px;
      padding: 16px 20px 20px;
      background: linear-gradient(var(--ink) 58%, rgba(12, 11, 10, 0));
    }

    .wordmark,
    .back {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .wordmark {
      font-size: 13px;
    }

    .back {
      font-size: 10px;
    }

    .filters {
      gap: 0 22px;
      padding-top: 0;
    }

    .filters button {
      min-height: 44px;
      font-size: 10px;
    }

    main {
      padding: 112px 20px 72px;
    }

    figure img {
      max-height: calc(100dvh - 140px);
    }

    .pip {
      right: 12px;
      top: 10px;
      width: 8px;
      height: 8px;
    }

    .close {
      top: 14px;
    }

    .remove {
      bottom: 14px;
    }
  }

  /* Two columns: portraits pair up side by side, everything wider takes the
     full width — a panorama as 2×1, which is still 3:1. */
  @media (max-width: 600px) {
    .grid {
      --cols: 2;
      --gap: 10px;
    }

    .pano {
      grid-row: span 1;
      grid-column: span 2;
    }
  }
</style>
