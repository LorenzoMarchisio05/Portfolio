---
import Layout from "../../../layouts/Layout.astro";
import PageBar from "../../../components/components/PageBar.astro";
import Footer from "../../../components/components/Footer.astro";
import { locales, useI18n } from "../../../i18n";

export const prerender = true;
export const getStaticPaths = () =>
  locales.flatMap((lang) => ["volstead", "aditus"].map((slug) => ({ params: { lang, slug } })));

// Where each project lives on the web; the words are in the dictionaries.
const urls = {
  volstead: "https://volsteadcircle.app",
  aditus: "https://github.com/LorenzoMarchisio05/Aditus",
};

const { t, href } = useI18n(Astro.url);
const slug = Astro.params.slug as keyof typeof urls;
const p = t.work[slug];
// Pictures live in public/projects.
const marks: Partial<Record<typeof slug, string>> = { volstead: "/projects/volstead-mark.svg", aditus: "/projects/aditus-mark.svg" };
const mark = marks[slug];
// Product screenshots, shown as a strip under the hero. Alt text is English
// in every language until the dictionaries carry it.
type Shot = { src: string; alt: string; w: number; h: number };
const shotSets: Partial<Record<typeof slug, Shot[]>> = {
  volstead: [
    ["1-today", "Tonight: the first night's twelve-card ticket"],
    ["2-build-it", "Build it: pouring a Daiquiri"],
    ["3-make-it", "Make it: turn the Negroni into a Mezcal Negroni"],
    ["4-specs", "Specs: 694 drinks with search and method filters"],
    ["5-my-bar", "My bar: the bottles you own, ticked"],
  ].map(([f, alt]) => ({ src: `/projects/volstead-${f}.webp`, alt, w: 700, h: 1522 })),
  aditus: [
    ["01-tabs-sidebar", "Vertical tabs: pinned, grouped and loose, beside the page"],
    ["04-tab-search", "Tab search filtering the list as you type"],
    ["03-profiles-and-sites", "Profiles and the sites mapped to them"],
  ].map(([f, alt]) => ({ src: `/projects/aditus-${f}.webp`, alt, w: 1400, h: 839 })),
};
const shots = shotSets[slug] ?? [];
---

<Layout title={p.title} description={p.description}>
  <PageBar back={href("/#founder")} angle="120°" crumbs={[{ label: t.work.crumb, href: href("/#founder") }, { label: p.crumb }]} />

  <main>
    <div class="glow"></div>

    <div class="hero">
      <div class="intro">
        <p class="eyebrow">120° · {t.roles.founder}</p>
        <h1 class="headline" set:html={p.headline} />
        <p class="lead">{p.lead}</p>
        <a class="go" href={urls[slug]} rel="noopener">{p.link}</a>
      </div>
      {mark && <img class="mark" src={mark} alt={p.alt} width="280" height="280" />}
    </div>

    {
      shots.length > 0 && (
        <div class={`shots ${slug}`}>
          {shots.map((s, i) => (
            <figure>
              <img src={s.src} alt={s.alt} width={s.w} height={s.h} decoding="async" />
              <figcaption>
                <span>{String(i + 1).padStart(2, "0")}</span> {s.alt}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <dl class="facts">
      {
        p.facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>

    <section class="features">
      <h2>{p.featuresTitle}</h2>
      <ol>
        {p.features.map(([title, text], i) => (
          <li data-lit>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="body">
      {p.body.map((para) => <p>{para}</p>)}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-y);
    padding: clamp(60px, 18vh - 70px, 130px) var(--pad-x) var(--pad-y);
  }

  main .glow {
    background: radial-gradient(56% 30% at 10% 12%, rgba(255, 47, 29, 0.07), transparent 64%);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 40px;
  }

  .mark {
    width: clamp(140px, 18vw, 230px);
    height: auto;
    justify-self: end;
    filter: drop-shadow(0 18px 40px rgba(212, 175, 55, 0.14));
  }

  .aditus .mark {
    border-radius: 22%;
  }

  /* Showcase: captioned, numbered, never scrolls on desktop. */
  .shots {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  .shots.volstead {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding-bottom: 56px;
  }

  .shots.volstead figure:nth-child(even) {
    transform: translateY(48px);
  }

  .shots.aditus {
    grid-template-columns: 1fr 1fr;
    gap: 28px 20px;
  }

  .shots.aditus figure:first-child {
    grid-column: 1 / -1;
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--hair-3);
    border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .shots.aditus img {
    border-radius: 12px;
  }

  figcaption {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--warm);
  }

  figcaption span {
    margin-right: 6px;
    color: var(--signal);
    letter-spacing: 0.14em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0 24px;
    margin: 0;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 0;
    border-top: 1px solid var(--hair-3);
  }

  dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--signal);
  }

  dd {
    margin: 0;
    color: var(--warm);
  }

  .features h2 {
    margin: 0 0 24px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--signal);
  }

  .features ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--hair-3);
  }

  .features li {
    display: grid;
    grid-template-columns: 56px minmax(0, 5fr) minmax(0, 7fr);
    gap: 8px 32px;
    align-items: baseline;
    padding: 28px 0;
    border-top: 1px solid var(--hair-3);
  }

  .n {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
  }

  .features h3 {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .features li p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm);
  }

  /* First paragraph reads as the statement; the rest as columns of notes. */
  .body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 28px 48px;
  }

  .body p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--warm);
  }

  .body p:first-child {
    grid-column: 1 / -1;
    max-width: 30em;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .go {
    width: fit-content;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 6px;
  }

  /* Motion: the hero settles in sequence; shots, facts and features arrive as
     they enter the viewport (scroll-driven where supported, else already there).
     `translate` is used so the staggered `transform` above is left alone. */
  @keyframes arrive {
    from { opacity: 0; translate: 0 28px; }
  }
  @keyframes mark-in {
    from { opacity: 0; scale: 0.86; rotate: -6deg; }
  }
  @keyframes drift {
    to { translate: 0 90px; }
  }
  @keyframes glow-drift {
    to { translate: 0 -160px; }
  }
  @keyframes shot-drift {
    from { translate: 0 8px; }
    to { translate: 0 -8px; }
  }
  @keyframes shot-drift-fast {
    from { translate: 0 16px; }
    to { translate: 0 -16px; }
  }
  @keyframes rule-in {
    from { transform: scaleX(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro > * { animation: arrive 700ms var(--ease) both; }
    .intro > :nth-child(2) { animation-delay: 80ms; }
    .intro > :nth-child(3) { animation-delay: 180ms; }
    .intro > :nth-child(4) { animation-delay: 280ms; }
    .mark { animation: mark-in 900ms var(--ease) 200ms both; }

    @supports (animation-timeline: view()) {
      .shots figure,
      .facts > div,
      .features li,
      .body p {
        animation: arrive linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }

    /* Depth: the mark and glow lag the page; each screenshot slides inside its
       frame, the staggered ones faster. */
    @supports (animation-timeline: view()) {
      .mark {
        animation: mark-in 900ms var(--ease) 200ms both, drift linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 700px;
      }

      main .glow {
        animation: glow-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 1200px;
      }

      .shots img {
        animation: shot-drift linear both;
        animation-timeline: view();
      }

      .shots figure:nth-child(even) img {
        animation-name: shot-drift-fast;
      }
    }

    .features li {
      position: relative;
      transition: padding-left 240ms var(--ease);
    }

    .features li::before {
      content: "";
      position: absolute;
      left: 0;
      top: -1px;
      height: 1px;
      width: 100%;
      background: var(--signal);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 480ms var(--ease);
    }

    .features li:hover::before {
      transform: scaleX(1);
    }

    .features li:hover .n {
      color: var(--signal);
    }

    .shots img {
      transition: transform 360ms var(--ease), border-color 200ms linear;
    }

    .shots figure:hover img {
      transform: translateY(-6px);
      border-color: rgba(242, 239, 233, 0.28);
    }
  }

  @media (max-width: 900px) {
    .shots.volstead {
      display: flex;
      overflow-x: auto;
      padding-bottom: 12px;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      scrollbar-color: var(--hair-3) transparent;
    }

    .shots.volstead figure {
      flex: none;
      width: 220px;
      scroll-snap-align: start;
    }

    .shots.volstead figure:nth-child(even) {
      transform: none;
    }

    .features li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .features li p {
      grid-column: 2;
    }
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .mark {
      grid-row: 1;
      justify-self: start;
      width: 96px;
    }

    .shots.aditus {
      grid-template-columns: 1fr;
    }

    main {
      padding: 32px 20px 72px;
    }

    .go {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-bottom: 0;
    }
  }
</style>
