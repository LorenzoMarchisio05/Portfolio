---
import Websites from "../../../layouts/Websites.astro";
import ProjectCard from "../../../components/websites/ProjectCard.astro";
import StartForm from "../../../components/websites/StartForm.astro";
import { getFeaturedProjects, getGalleryProjects, projectHref } from "../../../lib/projects";
import {
  carePlan,
  currency,
  domainFeeTypicalMax,
  extras,
  money,
  packages,
  paymentTerms,
  percent,
  vatIncluded,
} from "../../../data/pricing";
import { STUDIO_NAME } from "../../../data/studio";
import { localeParams, locales, useI18n } from "../../../i18n";

// Static: the only per-visit input, ?ref= and ?package=, is read by the form
// script in the browser.
export const prerender = true;
export const getStaticPaths = localeParams;

const { t, lang, href } = useI18n(Astro.url);
const s = t.studio;
const gallery = await getGalleryProjects();
const featured = await getFeaturedProjects();

const days = Object.fromEntries(packages.map((p) => [p.id, p.deliveryDays]));
const deposit = percent(paymentTerms.depositPercent, lang);
const onLaunch = percent(paymentTerms.onLaunchPercent, lang);
const domainFee = money(domainFeeTypicalMax, lang);

const why = [
  { ...s.why.fast, proof: undefined },
  { ...s.why.secure, proof: undefined },
  { ...s.why.languages, proof: gallery.find((p) => p.data.languages.length > 1) },
  { ...s.why.integrations, proof: gallery.find((p) => p.data.integrations.length > 0) },
];

const notice = s.care.notice(carePlan.noticeMonths);
const faq = s.faq.items(domainFee, carePlan.minimumMonths, notice);

const nav = [
  ...(featured.length ? [["work", s.nav.work]] : []),
  ["prices", s.nav.prices],
  ["process", s.nav.process],
  ["faq", s.nav.faq],
];

// ---- structured data, from the same data the page renders ----
const site = Astro.site ?? Astro.url;
const url = new URL(href("/websites"), site).href;

const service = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#studio`,
  name: `${STUDIO_NAME} · ${s.crumb}`,
  url,
  email: "me@lorenzomarchisio.me",
  availableLanguage: locales,
  inLanguage: lang,
  image: new URL("/social/og-websites.png", site).href,
  // The cheapest package up, in the currency the offers below use.
  priceRange: `${money(Math.min(...packages.map((p) => p.price ?? Infinity)), lang)}+`,
  founder: { "@id": new URL("/#person", site).href },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: s.schema.catalog,
    itemListElement: packages.map((p) => ({
      "@type": "Offer",
      name: s.schema.offer(p.name),
      ...(p.price !== null && {
        priceCurrency: currency,
        ...(p.from ? {} : { price: p.price }),
        priceSpecification: {
          "@type": "PriceSpecification",
          [p.from ? "minPrice" : "price"]: p.price,
          priceCurrency: currency,
          valueAddedTaxIncluded: vatIncluded,
        },
      }),
    })),
  },
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: faq.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Websites
  title={s.title}
  description={s.description(days.launch!, days.business!, money(packages[0].price!, lang))}
  image="/social/og-websites.png"
  back={href("/#founder")}
  cta="#start"
  skip={{ href: "#start", label: s.skip }}
  crumbs={[{ label: s.crumb }]}
  jsonLd={[service, faqPage]}
>
  <nav slot="nav" class="ws-sections" aria-label={s.nav.label}>
    <ul>
      {nav.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      <li><a href={href("/websites/gallery")}>{s.nav.gallery}</a></li>
    </ul>
  </nav>

  <!-- 1 · Opening -->
  <section id="top" class="ws-section hero" aria-labelledby="top-title">
    <p class="eyebrow">{s.hero.eyebrow}</p>
    <h1 id="top-title" class="title">{s.hero.title}</h1>
    <p class="lead sub">
      {s.hero.sub(days.launch!, days.business!, money(packages[0].price!, lang))}
    </p>
    <div class="row">
      <a class="ws-btn" href="#start">{s.cta}</a>
      {featured.length > 0 && <a class="ws-link" href="#work">{s.hero.work}</a>}
    </div>
  </section>

  <!-- 2 · Selected work: hidden until there is work to show -->
  {
    featured.length > 0 && (
      <section id="work" class="ws-section" aria-labelledby="work-title" tabindex="-1">
        <h2 id="work-title" class="ws-h2">{s.work.title}</h2>
        <p class="lead">{s.work.lead}</p>
        <div class="work">
          {featured.map((project) => <ProjectCard project={project} variant="compact" />)}
        </div>
        <a class="ws-link" href={href("/websites/gallery")}>
          {s.work.all(gallery.length >= 3 ? gallery.length : undefined)}
        </a>
      </section>
    )
  }

  <!-- 3 · What a website does for them -->
  <section id="for-you" class="ws-section" aria-labelledby="for-you-title" tabindex="-1">
    <h2 id="for-you-title" class="ws-h2">{s.forYou.title}</h2>
    <p class="lead">{s.forYou.lead}</p>
    <ul class="cols three">
      {
        s.forYou.items.map(({ title, text }) => (
          <li>
            <p class="ws-h3">{title}</p>
            <p class="muted">{text}</p>
          </li>
        ))
      }
    </ul>
    <p class="lead unsure">{s.forYou.unsure}</p>
    <a class="ws-link" href="#start">{s.cta}</a>
  </section>

  <!-- 4 · Packages and prices -->
  <section id="prices" class="ws-section" aria-labelledby="prices-title" tabindex="-1">
    <h2 id="prices-title" class="ws-h2">{s.prices.title}</h2>
    <p class="lead">{s.prices.lead}</p>

    <div class="cols four packages">
      {
        packages.map((p) => (
          <div>
            <h3 class="ws-h3">{p.name}</h3>
            <p class={p.price === null || p.from ? "price quote" : "price"}>
              {p.price === null
                ? s.prices.onRequest
                : p.from
                  ? s.prices.from(money(p.price, lang))
                  : money(p.price, lang)}
            </p>
            <p class="muted">
              {p.deliveryDays ? s.prices.days(p.deliveryDays) : s.prices.agreed}
            </p>
            {p.plus && (
              <p class="plus">{s.prices.plus(packages.find((q) => q.id === p.plus)!.name)}</p>
            )}
            <ul class="ticks">
              {s.prices.includes[p.id].map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="cols two shared">
      <div>
        <p class="small-label">{s.prices.allLabel}</p>
        <ul class="ticks">
          {s.prices.all.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="small-label">{s.prices.noneLabel}</p>
        <ul class="crosses">
          {s.prices.none(domainFee).map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <dl class="cols three terms">
      <div>
        <dt class="ws-h3">{s.prices.extras}</dt>
        <dd>{s.prices.language(money(extras.language, lang))}</dd>
        <dd>{s.prices.page(money(extras.page, lang))}</dd>
      </div>
      <div>
        <dt class="ws-h3">{s.prices.payment}</dt>
        <dd>{s.prices.split(deposit, onLaunch)}</dd>
      </div>
      <div>
        <dt class="ws-h3">{s.prices.vat}</dt>
        <dd>{s.prices.vatText}</dd>
      </div>
    </dl>

    <div class="row">
      <a class="ws-btn" href="#start">{s.cta}</a>
    </div>
  </section>

  <!-- 5 · How it works -->
  <section id="process" class="ws-section" aria-labelledby="process-title" tabindex="-1">
    <h2 id="process-title" class="ws-h2">{s.process.title}</h2>
    <ol class="steps">
      {
        s.process.steps(deposit, onLaunch).map(({ title, text }) => (
          <li>
            <p class="ws-h3">{title}</p>
            <p class="muted">{text}</p>
          </li>
        ))
      }
    </ol>
    <p class="lead">{s.process.timing(days.launch!, days.presence!, days.business!)}</p>
  </section>

  <!-- 6 · Care plan -->
  <section id="care-plan" class="ws-section" aria-labelledby="care-title" tabindex="-1">
    <h2 id="care-title" class="ws-h2">{s.care.title}</h2>
    <p class="lead">{s.care.lead}</p>
    <ul class="care">
      <li>{s.care.covers(carePlan.includedChangeMinutes)}</li>
      <li class="price">{s.care.price(money(carePlan.monthly, lang))}</li>
      <li>{s.care.vat}</li>
      <li>{s.care.term(carePlan.minimumMonths, notice)}</li>
      <li>{s.care.optional}</li>
    </ul>
  </section>

  <!-- 7 · Why a software engineer -->
  <section id="why" class="ws-section" aria-labelledby="why-title" tabindex="-1">
    <h2 id="why-title" class="ws-h2">{s.why.title}</h2>
    <ul class="cols two">
      {
        why.map(({ title, text, proof }) => (
          <li>
            <p class="ws-h3">{title}</p>
            <p class="muted">{text}</p>
            {proof && (
              <a class="ws-link" href={projectHref(proof, lang)}>
                {s.why.example(proof.data.clientName)}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <a class="ws-link" href={href("/")}>{s.why.about}</a>
  </section>

  <!-- 8 · FAQ -->
  <section id="faq" class="ws-section" aria-labelledby="faq-title" tabindex="-1">
    <h2 id="faq-title" class="ws-h2">{s.faq.title}</h2>
    <div class="faq">
      {
        faq.map(({ question, answer }) => (
          <details>
            <summary>{question}</summary>
            <p class="muted answer">{answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 9 · Start a project -->
  <StartForm />
</Websites>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: clamp(56px, 12vh, 140px);
    border-top: 0;
  }

  .hero p {
    margin: 0;
  }

  .title {
    margin: 0;
    max-width: 1000px;
    font-size: clamp(36px, 5.6vw, 76px);
    font-weight: 700;
    font-stretch: 80%;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .sub {
    max-width: 44em;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 8px;
  }

  .ws-section .lead {
    max-width: 42em;
  }

  .muted {
    color: var(--warm);
  }

  .cols {
    display: grid;
    gap: 28px clamp(24px, 4vw, 48px);
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cols > * {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--hair-3);
  }

  .work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 28px 0 32px;
  }

  .price {
    --size: clamp(28px, 3.2vw, 40px);
    display: flex;
    align-items: flex-end;
    min-height: calc(var(--size) * 1.1);
    font-size: var(--size);
    font-weight: 600;
    font-stretch: 88%;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  /* Smaller so the words fit, same height so the columns line up. */
  .price.quote {
    font-size: clamp(20px, 2.4vw, 28px);
  }

  .plus {
    margin: 0;
    font-size: 15px;
    color: var(--warm);
  }

  .small-label {
    margin-top: 8px !important;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .ticks,
  .crosses {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .ticks li::before,
  .crosses li::before {
    display: inline-block;
    width: 1.4em;
  }

  .ticks li::before {
    content: "+";
    color: var(--signal);
  }

  .crosses li {
    color: var(--warm);
  }

  .crosses li::before {
    content: "–";
  }

  .terms {
    margin-bottom: 32px;
  }

  .unsure {
    margin: 40px 0 12px !important;
  }

  .terms dd {
    margin: 0;
    color: var(--warm);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--hair-3);
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }

  .care {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 680px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .care .price {
    font-size: clamp(20px, 2.4vw, 26px);
  }

  #why .cols {
    margin-bottom: 32px;
  }

  .faq {
    max-width: 800px;
    border-bottom: 1px solid var(--hair-3);
  }

  .answer {
    padding: 0 0 18px;
  }

  /* Wide screens: heading on the left, content on the right. */
  @media (min-width: 1100px) {
    #care-plan,
    #faq {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      /* The tall right column stretches the last row, not the heading's. */
      grid-template-rows: auto 1fr;
      column-gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }

    #care-plan > .care,
    #faq > .faq {
      grid-column: 2;
      grid-row: 1 / span 2;
      max-width: none;
      margin-top: 0;
    }
  }

  @media (max-width: 1024px) {
    .four,
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .three,
    .four,
    .two,
    .steps {
      grid-template-columns: 1fr;
    }

    .row .ws-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
