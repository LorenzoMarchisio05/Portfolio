---
import Websites from "../../../../layouts/Websites.astro";
import ProjectCard from "../../../../components/websites/ProjectCard.astro";
import { getGalleryProjects, projectHref } from "../../../../lib/projects";
import { localeParams, useI18n } from "../../../../i18n";

export const prerender = true;
export const getStaticPaths = localeParams;

const { t, lang, href } = useI18n(Astro.url);
const projects = await getGalleryProjects();
const studio = href("/websites");
const start = `${studio}?ref=gallery#start`;

const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;

const collection = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t.projects.schema,
  url: abs(href("/websites/gallery")),
  inLanguage: lang,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: projects.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "CreativeWork",
        name: p.data.status === "concept" ? t.projects.named(p.data.clientName) : p.data.clientName,
        url: abs(projectHref(p, lang)),
        image: abs(p.data.screenshots.desktop.src),
        ...(p.data.launchedAt && { dateCreated: p.data.launchedAt.toISOString().slice(0, 10) }),
      },
    })),
  },
};
---

<Websites
  title={t.projects.title}
  description={t.projects.description}
  noindex={projects.length === 0}
  back={studio}
  cta={start}
  skip={{ href: "#content", label: t.skip }}
  crumbs={[{ label: t.studio.crumb, href: studio }, { label: t.projects.crumb }]}
  jsonLd={[collection]}
>
  <header class="ws-section head">
    <h1 class="ws-h2 title">{t.projects.heading}</h1>
    <p class="lead">{t.projects.lead}</p>
  </header>

  <div class="list">
    {
      projects.length > 0 ? (
        projects.map((project) => <ProjectCard project={project} variant="full" />)
      ) : (
        <div class="empty">
          <p class="lead">{t.projects.empty}</p>
          <a class="ws-link" href={studio}>{t.projects.studio}</a>
        </div>
      )
    }
  </div>

  <section class="ws-section cta" aria-labelledby="cta-title">
    <h2 id="cta-title" class="ws-h2">{t.projects.ctaTitle}</h2>
    <p class="lead">{t.projects.ctaLead}</p>
    <div class="row">
      <a class="ws-btn" href={start}>{t.studio.cta}</a>
    </div>
  </section>
</Websites>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 24px;
    border-top: 0;
  }

  .title {
    font-size: clamp(40px, 6vw, 76px);
  }

  .list {
    padding: 0 var(--ws-gutter) var(--pad-y);
  }

  .empty {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px 0 0;
    border-top: 1px solid var(--hair);
  }

  .empty .lead {
    max-width: 640px;
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .list {
      padding: 0 16px 56px;
    }

    .row .ws-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
