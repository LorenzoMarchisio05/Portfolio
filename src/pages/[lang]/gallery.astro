---
import { readFile } from "node:fs/promises";
import { imageMetadata } from "astro/assets/utils";
import Layout from "../../layouts/Layout.astro";
import PageBar from "../../components/components/PageBar.astro";
import Footer from "../../components/components/Footer.astro";
import { localeParams, useI18n } from "../../i18n";

// Built once, not per request: the grid needs every photo's size, and only the
// build has the files on disk — the worker has no node:fs.
export const prerender = true;
export const getStaticPaths = localeParams;

const { t, lang, href } = useI18n(Astro.url);
const g = t.gallery;
// A filename word in the page's language; one the dictionary leaves out as it is spelled.
const word = (w: string) => g.words[w] ?? w.replaceAll("_", " ");

// Every photograph in /public/photos/, as written by scripts/photos.sh. Files
// are named `<number>-<category>[-more-words].webp`: `07-alpine-lake` is photo 7
// in ALPINE. Any number of digits, sorted numerically so 9 comes before 10; a
// two-word category takes an underscore, `08-street_food`. The words name the
// filters and make the alt text, through the dictionary's `words`.
const photos = await Promise.all(
  Object.keys(import.meta.glob("/public/photos/*.webp"))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async (path) => {
      const { width, height } = await imageMetadata(await readFile(`.${path}`));
      const name = path.slice(path.lastIndexOf("/") + 1, -".webp".length);
      const [n, category = "", ...words] = name.split("-");
      const subject = [category, ...words].filter(Boolean).map(word).join(" ");
      return {
        src: path.slice("/public".length),
        thumb: `/photos/thumbs/${name}.webp`,
        alt: g.alt(n, subject),
        category,
        ratio: +(width / height).toFixed(3),
      };
    }),
);

const categories = [...new Set(photos.map((p) => p.category).filter(Boolean))]
  .map((c) => ({ id: c, label: word(c) }))
  .sort((a, b) => a.label.localeCompare(b.label, lang));
// Showcase picks, spread evenly through the set: landscapes for the pinned
// strip, one wide frame for the reveal, the rest for two drifting rows.
const spread = <T,>(list: T[], n: number) =>
  list.length <= n ? list : Array.from({ length: n }, (_, i) => list[Math.floor((i * list.length) / n)]);
const wide = photos.filter((p) => p.ratio >= 1.2);
const strip = spread(wide, 8);
const feature = wide.filter((p) => p.ratio >= 1.45)[7] ?? wide[0];
const rest = photos.filter((p) => !strip.includes(p) && p !== feature);
const rows = [spread(rest.filter((_, i) => i % 2 === 0), 14), spread(rest.filter((_, i) => i % 2 === 1), 14)];
const count = String(photos.length).padStart(2, "0");
---

<Layout
  title={g.title}
  description={g.description}
  image="/social/og-gallery.jpg"
>
  <style is:global>
    html:root { --signal: #c8794a; --ink: #110b08; }
  </style>
  <PageBar back={href("/#photography")} angle="240°" crumbs={[{ label: g.crumb }]} />

  <main>
    <div class="glow"></div>
    <div class="rail" aria-hidden="true"></div>

    <header class="intro">
      <div class="lead">
        <p class="eyebrow">240° · {t.roles.photographer}</p>
        <h1 class="headline" set:html={g.headline} />
      </div>
      <div class="side">
        <p class="meta"><b class="num" style={`--to:${photos.length}`} aria-label={count}><span aria-hidden="true">{count}</span></b> <span>{g.count(count).replace(count, "").trim()}</span></p>
      </div>
    </header>

    {
      strip.length > 3 && (
        <section class="pin" aria-hidden="true">
          <div class="stage">
            <p class="cap"><b>01</b> / 03</p>
            <div class="bar"><i></i></div>
            <div class="track">
              {strip.map((p, i) => (
                <button type="button" class="pick" tabindex="-1" data-full={p.src} style={`--r:${p.ratio};--i:${i}`}>
                  <img src={p.src} alt="" loading="lazy" decoding="async" />
                  <span>{String(i + 1).padStart(2, "0")}</span>
                </button>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="reveal" aria-hidden="true">
      <p class="cap"><b>02</b> / 03</p>
      <button type="button" class="pick" tabindex="-1" data-full={feature.src}>
        <img src={feature.src} alt="" loading="lazy" decoding="async" />
      </button>
    </section>

    <section class="rows" aria-hidden="true">
      <p class="cap"><b>03</b> / 03</p>
      {
        rows.map((row, k) => (
          <div class={`marquee ${k ? "rev" : ""}`}>
            <div class="belt">
              {[...row, ...row].map((p) => (
                <button type="button" class="pick" tabindex="-1" data-full={p.src} style={`--r:${p.ratio}`}>
                  <img src={p.thumb} alt="" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <div class="wallhead">
      <span class="cap"><b>{count}</b></span>
        {
          categories.length > 1 && (
            <div class="filters" role="group" aria-label={g.filter}>
              <button type="button" data-filter="" aria-pressed="true">
                {g.all}
              </button>
              {categories.map((c) => (
                <button type="button" data-filter={c.id} aria-pressed="false">
                  {c.label.toLocaleUpperCase(lang)}
                </button>
              ))}
            </div>
          )
        }
    </div>

    <ul class="grid">
      {
        photos.map((p, i) => (
          <li style={`--r:${p.ratio}`} data-category={p.category}>
            <button class="shot" type="button" data-cursor="frame" data-full={p.src}>
              <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
              <span class="tag" aria-hidden="true">
                <i>{String(i + 1).padStart(2, "0")}</i>
                {p.category && <i>{word(p.category).toLocaleUpperCase(lang)}</i>}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </main>

  <Footer />

  <dialog id="viewer" aria-label={g.viewer}>
    <button class="close" type="button">{g.close}</button>
    <figure data-cursor="frame">
      <img alt="" />
      <span class="pip"></span>
    </figure>
    <button class="nav prev" type="button" aria-label="←" data-step="-1">←</button>
    <button class="nav next" type="button" aria-label="→" data-step="1">→</button>
    <p class="keys" aria-hidden="true"><span class="at"></span> · {g.keys}</p>
    <a
      class="remove"
      href="mailto:me@lorenzomarchisio.me"
      data-subject={g.removalSubject}
      data-body={g.removalBody}>{g.removal}</a
    >
  </dialog>
</Layout>

<script>
  const viewer = document.getElementById("viewer") as HTMLDialogElement;
  const big = viewer.querySelector("img")!;
  const remove = viewer.querySelector<HTMLAnchorElement>(".remove")!;
  const inbox = remove.href;
  const shots = Array.from(document.querySelectorAll<HTMLButtonElement>(".shot"));
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const at = viewer.querySelector(".at")!;
  let current = shots[0];

  // A filtered-out photo leaves the grid entirely, so the dense packing closes
  // the gap on its own.
  filters.forEach((filter) =>
    filter.addEventListener("click", () => {
      const category = filter.dataset.filter;
      filters.forEach((f) => f.setAttribute("aria-pressed", String(f === filter)));
      shots.forEach((shot) => {
        shot.parentElement!.hidden =
          category !== "" && shot.parentElement!.dataset.category !== category;
      });
    }),
  );

  let dir = 0;
  const show = (shot: HTMLButtonElement) => {
    current = shot;
    const shown = shots.filter((s) => !s.parentElement!.hidden);
    at.textContent = `${String(shown.indexOf(shot) + 1).padStart(2, "0")} / ${String(shown.length).padStart(2, "0")}`;
    big.src = shot.dataset.full!;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
      big.animate(
        [{ opacity: 0, translate: `${dir * 36}px 0`, scale: 0.97 }, { opacity: 1, translate: "0 0", scale: 1 }],
        { duration: 380, easing: "cubic-bezier(.2,.7,.1,1)" },
      );
    big.alt = shot.querySelector("img")!.alt;
    // No server and no email quota: the request leaves from the visitor's own
    // mail app, already naming the photo, with an address to reply to.
    const name = shot.dataset.full!.slice("/photos/".length, -".webp".length);
    const subject = remove.dataset.subject!.replace("{name}", name);
    const body = remove.dataset.body!.replace("{name}", name);
    remove.href = `${inbox}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  // Browses only what the filter shows, in filename order rather than the
  // grid's packed order, and wraps: → on the last frame goes back to the first.
  const step = (by: number) => {
    dir = by;
    const shown = shots.filter((shot) => !shot.parentElement!.hidden);
    const at = shown.indexOf(current);
    show(shown[(at + by + shown.length) % shown.length]);
  };

  shots.forEach((shot) =>
    shot.addEventListener("click", () => {
      dir = 0;
      show(shot);
      viewer.showModal();
    }),
  );

  // Showcase frames open the same viewer, on their copy in the wall.
  document.querySelectorAll<HTMLButtonElement>(".pick").forEach((pick) =>
    pick.addEventListener("click", () => {
      const home = shots.find((shot) => shot.dataset.full === pick.dataset.full);
      if (!home) return;
      home.parentElement!.hidden = false;
      dir = 0;
      show(home);
      viewer.showModal();
    }),
  );

  viewer.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight") step(1);
    if (event.key === "ArrowLeft") step(-1);
  });

  // A viewer, not an editor: the removal link is the only thing inside to
  // click, so any other click — the close button included — puts it away.
  // Escape is native to <dialog>.
  viewer.addEventListener("click", (event) => {
    const nav = (event.target as Element).closest<HTMLElement>("[data-step]");
    if (nav) return step(Number(nav.dataset.step));
    if (!(event.target as Element).closest(".remove")) viewer.close();
  });

  // Land on the frame last viewed, not the one that opened the viewer.
  viewer.addEventListener("close", () => current.focus());
</script>

<style>
  main {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gap-y);
    padding: clamp(60px, 18vh - 70px, 130px) var(--pad-x) var(--pad-y);
    /* The grid sizes its rows off this width. */
    container-type: inline-size;
  }

  /* Starts above main, behind the sticky bar, so the wash has no top edge. */
  main .glow {
    inset-block-start: -120px;
    background:
      radial-gradient(56% 30% at 10% 12%, color-mix(in srgb, var(--signal) 12%, transparent), transparent 64%),
      radial-gradient(40% 24% at 95% 60%, color-mix(in srgb, var(--signal) 7%, transparent), transparent 70%);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px clamp(32px, 6vw, 96px);
    max-width: none;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--hair-3);
  }

  .lead {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .headline {
    margin: 0;
    font-size: clamp(52px, 9.5vw, 148px);
    font-weight: 700;
    font-stretch: 78%;
    letter-spacing: -0.035em;
    line-height: 0.84;
  }

  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 22px;
    max-width: 420px;
    text-align: right;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--warm);
  }

  .meta .num {
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 700;
    font-stretch: 79%;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--signal);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 24px;
  }

  .filters button {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--warm);
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 6px;
  }

  .filters button:hover {
    color: var(--signal);
  }

  .filters [aria-pressed="true"] {
    color: var(--bone);
    border-bottom-color: var(--signal);
  }

  /* Justified rows: every photo keeps its own ratio, grows to fill its row, and
     the row height follows. No crops, no holes, filename order kept. */
  .grid {
    --row: clamp(150px, 21vw, 340px);
    --gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  .grid li {
    flex: calc(var(--r) * 100) 1 calc(var(--r) * var(--row));
    aspect-ratio: var(--r);
    min-width: 0;
  }

  /* Lets the last row stay at its natural height instead of stretching. */
  .grid::after {
    content: "";
    flex: 999 1 0;
  }

  .shot {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--frame-fill);
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0);
    transition: box-shadow 140ms var(--ease);
  }

  .shot:hover::after,
  .shot:focus-visible::after {
    box-shadow: inset 0 0 0 1px var(--signal);
  }

  .shot { overflow: clip; }

  .tag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    padding: 34px 12px 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    font-style: normal;
    color: var(--bone);
    background: linear-gradient(transparent, rgba(12, 11, 10, 0.78));
    opacity: 0;
    translate: 0 8px;
    transition: opacity 240ms var(--ease), translate 240ms var(--ease);
    pointer-events: none;
  }

  .tag i { font-style: normal; }

  .shot:hover .tag,
  .shot:focus-visible .tag {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot img {
      transition: scale 900ms var(--ease), filter 400ms linear;
      filter: saturate(0.82) brightness(0.92);
    }

    .shot:hover img,
    .shot:focus-visible img {
      scale: 1.05;
      filter: none;
    }

    /* The wall moves: tiles rise in from alternating sides, then drift at
       three different speeds while they cross the screen. */
    @supports (animation-timeline: view()) {
      .grid li {
        animation: tile-in linear both, tile-drift linear both;
        animation-timeline: view(), view();
        animation-range: entry 0% entry 60%, cover 0% cover 100%;
      }
      .grid li:nth-child(3n + 1) { --dy: 14px; }
      .grid li:nth-child(3n + 2) { --dy: -10px; --rot: 2deg; }
      .grid li:nth-child(3n) { --dy: 22px; --rot: -2deg; }
    }

    /* One frame lit, the rest step back. */
    .grid:has(.shot:hover) li:not(:hover) .shot img {
      filter: saturate(0.4) brightness(0.55);
    }
  }

  @keyframes tile-drift {
    from { translate: 0 var(--dy, 20px); }
    to { translate: 0 calc(var(--dy, 20px) * -1); }
  }

  @keyframes tile-in {
    from { opacity: 0; rotate: var(--rot, 0deg); scale: 0.92; }
  }

  @media (pointer: coarse) {
    .tag { display: none; }
    .shot img { filter: none; }
  }

  /* ---- viewer ---- */

  :global(html:has(#viewer[open])) {
    overflow: hidden;
  }

  dialog {
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--pad-x);
    border: 0;
    background: rgba(12, 11, 10, 0.96);
    color: var(--bone);
  }

  dialog::backdrop {
    background: transparent;
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    animation: lm-view 320ms var(--ease) both;
  }

  figure {
    position: relative;
    margin: 0;
    box-shadow: 0 50px 140px rgba(0, 0, 0, 0.8);
  }

  figure::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 233, 0.4);
  }

  figure img {
    display: block;
    max-width: calc(100vw - 2 * var(--pad-x));
    max-height: calc(100dvh - 160px);
  }

  .pip {
    position: absolute;
    right: 14px;
    top: 12px;
    width: 9px;
    height: 9px;
    background: var(--signal);
  }

  .keys {
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dim);
  }

  /* No keyboard to press. */
  @media (pointer: coarse) {
    .keys {
      display: none;
    }
  }

  .close,
  .remove {
    position: absolute;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--warm);
    background: transparent;
    border: 1px solid var(--hair-4);
    padding: 12px 22px;
  }

  .close {
    top: 22px;
    right: var(--pad-x);
  }

  .remove {
    bottom: 22px;
    left: var(--pad-x);
  }

  .close:hover,
  .remove:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  @keyframes lm-view {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[open] {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .grid { --row: 22vw; }
  }

  @media (max-width: 768px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      align-items: flex-start;
      text-align: left;
    }

    .filters {
      justify-content: flex-start;
      gap: 0 22px;
      padding-top: 0;
    }

    .filters button {
      min-height: 44px;
      font-size: 10px;
    }

    main {
      padding: 32px 20px 72px;
    }

    figure img {
      max-height: calc(100dvh - 140px);
    }

    .pip {
      right: 12px;
      top: 10px;
      width: 8px;
      height: 8px;
    }

    .close {
      top: 14px;
    }

    .remove {
      bottom: 14px;
    }
  }

  @media (max-width: 600px) {
    .grid {
      --row: 38vw;
      --gap: 6px;
    }
  }

  /* ---- showcase ---- */

  .cap {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--dim);
  }

  .cap b { color: var(--signal); font-weight: 500; }

  .pick {
    padding: 0;
    border: 0;
    background: var(--frame-fill);
    cursor: pointer;
  }

  .pick img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wallhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px 32px;
    padding-top: 22px;
    border-top: 1px solid var(--hair-3);
  }

  /* Pinned strip: the page stops, the frames travel sideways. */
  .pin {
    height: 300vh;
    margin-inline: calc(var(--pad-x) * -1);
    view-timeline: --strip block;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    overflow: clip;
  }

  .stage .cap { padding-inline: var(--pad-x); }

  .track {
    display: flex;
    gap: clamp(14px, 2vw, 32px);
    width: max-content;
    padding-inline: var(--pad-x);
  }

  .track .pick {
    position: relative;
    height: min(62vh, 560px);
    aspect-ratio: var(--r);
    overflow: clip;
  }

  .track .pick span {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--bone);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
  }

  /* A frame wipes open to full width. */
  .reveal {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .reveal .pick {
    width: 100%;
    aspect-ratio: 2.2;
    overflow: clip;
  }

  /* Two belts that never stop, opposite ways. */
  .rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-inline: calc(var(--pad-x) * -1);
    overflow: clip;
  }

  .rows .cap { padding-inline: var(--pad-x); }

  .belt {
    display: flex;
    gap: 12px;
    padding-right: 12px;
    width: max-content;
  }

  .belt .pick {
    height: clamp(120px, 15vw, 220px);
    aspect-ratio: var(--r);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .track {
        animation: strip-slide linear both;
        animation-timeline: --strip;
        animation-range: cover 25% cover 75%;
      }

      .track .pick img {
        animation: strip-parallax linear both;
        animation-timeline: --strip;
        animation-range: cover 25% cover 75%;
        scale: 1.25;
      }

      .reveal .pick {
        animation: wipe linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 45%;
      }

      .reveal .pick img {
        animation: wipe-zoom linear both;
        animation-timeline: view();
        animation-range: entry 5% exit 40%;
      }
    }

    .belt { animation: belt 70s linear infinite; }
    .rev .belt { animation-direction: reverse; animation-duration: 90s; }
    .marquee:hover .belt { animation-play-state: paused; }

    .belt .pick { transition: scale 400ms var(--ease), filter 300ms linear; filter: saturate(0.7) brightness(0.8); }
    .belt .pick:hover { scale: 1.06; filter: none; }
    .track .pick { transition: filter 300ms linear; }
  }

  @keyframes strip-slide {
    to { translate: calc(-100% + 100vw) 0; }
  }

  @keyframes strip-parallax {
